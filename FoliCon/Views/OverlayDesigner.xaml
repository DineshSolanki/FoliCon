<UserControl x:Class="FoliCon.Views.OverlayDesigner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:FoliCon.ViewModels"
             xmlns:langs="clr-namespace:FoliCon.Properties.Langs"
             xmlns:extension="clr-namespace:FoliCon.Modules.Extension"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:OverlayDesignerViewModel}"
             Background="{DynamicResource RegionBrush}"
             Focusable="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <hc:Boolean2VisibilityReConverter x:Key="InvertedBoolToVis" />

        <!-- Compact numeric editor for position/size fields. -->
        <Style x:Key="GeometryBox" TargetType="hc:NumericUpDown"
               BasedOn="{StaticResource {x:Type hc:NumericUpDown}}">
            <Setter Property="Width" Value="76" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Minimum" Value="-2000" />
            <Setter Property="Maximum" Value="2000" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="DecimalPlaces" Value="0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding Title}" />
            <Setter Property="Height" Value="780" />
            <Setter Property="Width" Value="1180" />
            <Setter Property="MinHeight" Value="700" />
            <Setter Property="MinWidth" Value="1100" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}" />
        <KeyBinding Key="Left" Command="{Binding NudgeCommand}" CommandParameter="left" />
        <KeyBinding Key="Right" Command="{Binding NudgeCommand}" CommandParameter="right" />
        <KeyBinding Key="Up" Command="{Binding NudgeCommand}" CommandParameter="up" />
        <KeyBinding Key="Down" Command="{Binding NudgeCommand}" CommandParameter="down" />
        <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding NudgeCommand}" CommandParameter="left-shift" />
        <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding NudgeCommand}" CommandParameter="right-shift" />
        <KeyBinding Key="Up" Modifiers="Shift" Command="{Binding NudgeCommand}" CommandParameter="up-shift" />
        <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding NudgeCommand}" CommandParameter="down-shift" />
    </UserControl.InputBindings>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Modern Elevated Toolbar -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10,8"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel LastChildFill="False">
                <!-- Return to template picker -->
                <Button DockPanel.Dock="Left" Margin="0,0,8,0" Padding="10,4"
                        Style="{StaticResource ButtonDefault}"
                        Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}"
                        Click="OnBackToTemplatesClicked"
                        AutomationProperties.HelpText="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerBackToTemplatesHelp}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ArrowLeftGeometry}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Source={StaticResource FoliConLangs}, Path=OverlayDesignerBackToTemplates}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Open overlay folder / package -->
                <Button DockPanel.Dock="Left" Margin="0,0,8,0" Padding="12,4"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding OpenPackageCommand}"
                        AutomationProperties.HelpText="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerOpenHelp}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderOpenGeometry}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerOpen}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator DockPanel.Dock="Left" Margin="4,4,10,4" />

                <!-- Undo -->
                <Button DockPanel.Dock="Left" Margin="0,0,6,0" Padding="10,4"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding UndoCommand}"
                        AutomationProperties.HelpText="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerUndoHelp}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource UndoGeometry}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Source={StaticResource FoliConLangs}, Path=Undo}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Redo -->
                <Button DockPanel.Dock="Left" Margin="0,0,8,0" Padding="10,4"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding RedoCommand}"
                        AutomationProperties.HelpText="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerRedoHelp}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource RedoGeometry}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Source={StaticResource FoliConLangs}, Path=OverlayDesignerRedo}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator DockPanel.Dock="Left" Margin="4,4,10,4" />

                <!-- Zoom Controls Capsule -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerZoom}}"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="1×" GroupName="Zoom" Margin="2,0"
                                         VerticalAlignment="Center" FontSize="11.5"
                                         Command="{Binding SetZoomCommand}" CommandParameter="1" />
                            <RadioButton Content="2×" GroupName="Zoom" Margin="4,0"
                                         VerticalAlignment="Center" FontSize="11.5" IsChecked="True"
                                         Command="{Binding SetZoomCommand}" CommandParameter="2" />
                            <RadioButton Content="4×" GroupName="Zoom" Margin="2,0"
                                         VerticalAlignment="Center" FontSize="11.5"
                                         Command="{Binding SetZoomCommand}" CommandParameter="4" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Help Button -->
                <Button DockPanel.Dock="Right" Padding="12,4"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding OpenHelpCommand}"
                        AutomationProperties.HelpText="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerHelpTooltip}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource HelpGeometry}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Source={StaticResource FoliConLangs}, Path=Help}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Unsaved Changes Badge Pill -->
                <Border DockPanel.Dock="Right"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                        Background="#14FF9800"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8,3"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6"
                                 Fill="{DynamicResource WarningBrush}"
                                 Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={StaticResource FoliConLangs}, Path=OverlayDesignerUnsavedChanges}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- First-run template picker screen -->
        <Border Grid.Row="1"
                Visibility="{Binding ShowTemplatePicker, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Path Data="{StaticResource SparkleStarGeometry}"
                              Fill="{DynamicResource PrimaryBrush}"
                              Width="20" Height="20" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerStartNew}}"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,20" MaxWidth="680"
                               HorizontalAlignment="Left"
                               Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerTemplatePickerHint}}" />

                    <!-- Templates Gallery -->
                    <ItemsControl ItemsSource="{Binding Templates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="205" Margin="0,0,14,14" Padding="12" CornerRadius="8"
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="{Binding Description}"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        AutomationProperties.HelpText="{Binding Description}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.CreateFromTemplateCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>

                                    <StackPanel>
                                        <!-- Artwork Preview -->
                                        <Border Height="136" Margin="0,0,0,10" CornerRadius="6"
                                                Background="{DynamicResource SecondaryRegionBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                                       Margin="6"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock FontSize="11"
                                                           Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerRendering}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsPreviewLoading,
                                                                       Converter={StaticResource BoolToVis}}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,3"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Height="32"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                        <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerUseTemplate}}"
                                                Margin="0,10,0,0" Padding="8,5"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding DataContext.CreateFromTemplateCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <AutomationProperties.Name>
                                                <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                                    <Binding Source="{StaticResource FoliConLangs}"
                                                             Path="OverlayDesignerUseTemplateAutomation" />
                                                    <Binding Path="DisplayName" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Saved drafts section -->
                    <StackPanel Visibility="{Binding HasDrafts, Converter={StaticResource BoolToVis}}"
                                Margin="0,12,0,0">
                        <Separator Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource DocumentGeometry}"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerContinueDraft}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,12"
                                   Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerDraftsHint}}" />

                        <ItemsControl ItemsSource="{Binding Drafts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="6"
                                            Background="{DynamicResource RegionBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           FontSize="13.5" Margin="0,0,0,2"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock FontSize="11.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                                            <Binding Source="{StaticResource FoliConLangs}"
                                                                     Path="OverlayDesignerDraftSavedAt" />
                                                            <Binding Path="SavedAt" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button DockPanel.Dock="Right" Padding="12,4"
                                                    Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerDeleteDraft}}"
                                                    Margin="8,0,0,0" FontSize="11.5"
                                                    Style="{StaticResource ButtonDanger}"
                                                    Command="{Binding DataContext.DeleteDraftCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <AutomationProperties.Name>
                                                    <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                                        <Binding Source="{StaticResource FoliConLangs}"
                                                                 Path="OverlayDesignerDeleteDraftAutomation" />
                                                        <Binding Path="DisplayName" />
                                                    </MultiBinding>
                                                </AutomationProperties.Name>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Padding="14,4"
                                                    Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerResumeDraft}}"
                                                    FontSize="11.5"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Command="{Binding DataContext.ResumeDraftCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <AutomationProperties.Name>
                                                    <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                                        <Binding Source="{StaticResource FoliConLangs}"
                                                                 Path="OverlayDesignerResumeDraftAutomation" />
                                                        <Binding Path="DisplayName" />
                                                    </MultiBinding>
                                                </AutomationProperties.Name>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0"
                               Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerOpenFolderHint}}" />

                    <!-- Exit button for picker -->
                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCloseDesigner}}"
                            Style="{StaticResource ButtonDefault}"
                            Padding="16,6" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Click="OnCloseClicked" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Editor Workspace -->
        <Grid Grid.Row="1" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Element / Layers Rail -->
            <Border Grid.Column="0" Margin="0,0,10,0" Padding="12"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource LayersGeometry}"
                              Fill="{DynamicResource PrimaryBrush}"
                              Width="16" Height="16" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerElements}}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                               Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerElementOrderHint}}" />

                    <ItemsControl ItemsSource="{Binding Elements}"
                                  KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Element" Margin="0,2" Padding="6,4"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.SelectElementCommand,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}"
                                             AutomationProperties.Name="{Binding BoundsDescription}">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Reorder layer z-order -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Button Padding="10,4" Margin="0,0,6,0" MinWidth="36"
                                Style="{StaticResource ButtonDefault}"
                                Command="{Binding MoveLayerUpCommand}"
                                CommandParameter="{Binding SelectedElement}"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerMoveLayerBack}}"
                                AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerMoveLayerBackAutomation}}">
                            <Path Data="{StaticResource ArrowUpGeometry}"
                                  Fill="{DynamicResource PrimaryTextBrush}"
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Padding="10,4" MinWidth="36"
                                Style="{StaticResource ButtonDefault}"
                                Command="{Binding MoveLayerDownCommand}"
                                CommandParameter="{Binding SelectedElement}"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerMoveLayerForward}}"
                                AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerMoveLayerForwardAutomation}}">
                            <Path Data="{StaticResource DownChevronGeometry}"
                                  Fill="{DynamicResource PrimaryTextBrush}"
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </StackPanel>

                    <Separator Margin="0,12" />

                    <!-- Visibility Toggles -->
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerShow}}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,6" />
                    <CheckBox Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayLayerBase}}"
                              Margin="0,4" IsChecked="{Binding HasBaseLayer}" />
                    <CheckBox Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayLayerFront}}"
                              Margin="0,4" IsChecked="{Binding HasFrontLayer}" />
                    <CheckBox Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayLayerTitleText}}"
                              Margin="0,4" IsChecked="{Binding TitleIsVisible}" />
                </StackPanel>
            </Border>

            <!-- Column 1: Canvas Area -->
            <Border Grid.Column="1" Margin="0,0,10,0"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <Grid x:Name="CanvasRoot"
                          Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Background="Transparent"
                          AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCanvasAutomation}}">

                        <!-- Checkerboard background for transparency preview -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#FFF0F0F0">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,16,16" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#FFD8D8D8">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,8,8" />
                                                        <RectangleGeometry Rect="8,8,8,8" />
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Image Source="{Binding PreviewImage}"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerPreviewAutomation}}" />

                        <Canvas x:Name="AdornerLayer" Background="Transparent" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Column 2: Properties Inspector -->
            <Border Grid.Column="2" Padding="14"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Selected Element Header -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource WrenchGeometry}"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="15" Height="15" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedElementName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Geometry controls for selected element -->
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,8"
                                       Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerGeometryHint}}" />

                            <Border Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10,8" Margin="0,0,0,4">
                                <UniformGrid Columns="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerAxisX}}"
                                                   VerticalAlignment="Center" MinWidth="18" Margin="0,0,4,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <hc:NumericUpDown Style="{StaticResource GeometryBox}"
                                                          Value="{Binding SelectedLeft, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerLeftPosition}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerAxisY}}"
                                                   VerticalAlignment="Center" MinWidth="18" Margin="0,0,4,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <hc:NumericUpDown Style="{StaticResource GeometryBox}"
                                                          Value="{Binding SelectedTop, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerTopPosition}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerWidthShort}}"
                                                   VerticalAlignment="Center" MinWidth="18" Margin="0,0,4,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <hc:NumericUpDown Style="{StaticResource GeometryBox}" Minimum="0"
                                                          Value="{Binding SelectedWidth, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerWidth}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerHeightShort}}"
                                                   VerticalAlignment="Center" MinWidth="18" Margin="0,0,4,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <hc:NumericUpDown Style="{StaticResource GeometryBox}" Minimum="0"
                                                          Value="{Binding SelectedHeight, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerHeight}}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <Separator Margin="0,12" />

                        <!-- Metadata Expander -->
                        <Expander Header="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerMetadata}}"
                                  IsExpanded="True">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerName}}"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerId}}"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OverlayId, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerIdHint}}" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerAuthor}}"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Author, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerVersion}}"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OverlayVersion, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerDescription}}"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayTags}}"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerTagsHint}}" />
                            </StackPanel>
                        </Expander>

                        <!-- Layer Images Expander -->
                        <Expander Header="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerLayerImages}}"
                                  Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerBaseImage}}"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding BaseLayerImagePath}" Style="{StaticResource HintText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerBrowse}}"
                                            Style="{StaticResource ButtonDefault}"
                                            Padding="10,3" Margin="0,0,6,0"
                                            Command="{Binding BrowseImageCommand}" CommandParameter="base" />
                                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerClear}}"
                                            Style="{StaticResource ButtonDefault}"
                                            Padding="10,3"
                                            Command="{Binding ClearImageCommand}" CommandParameter="base" />
                                </StackPanel>

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerFrontImage}}"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding FrontLayerImagePath}" Style="{StaticResource HintText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerBrowse}}"
                                            Style="{StaticResource ButtonDefault}"
                                            Padding="10,3" Margin="0,0,6,0"
                                            Command="{Binding BrowseImageCommand}" CommandParameter="front" />
                                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerClear}}"
                                            Style="{StaticResource ButtonDefault}"
                                            Padding="10,3"
                                            Command="{Binding ClearImageCommand}" CommandParameter="front" />
                                </StackPanel>

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerOpacityMask}}"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding PosterOpacityMaskPath}" Style="{StaticResource HintText}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerBrowse}}"
                                            Style="{StaticResource ButtonDefault}"
                                            Padding="10,3" Margin="0,0,6,0"
                                            Command="{Binding BrowseImageCommand}" CommandParameter="mask" />
                                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerClear}}"
                                            Style="{StaticResource ButtonDefault}"
                                            Padding="10,3"
                                            Command="{Binding ClearImageCommand}" CommandParameter="mask" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Poster Expander -->
                        <Expander Header="{extension:Lang Key={x:Static langs:LangKeys.Poster}}" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerRadius}}"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerRadiusHint}}" />

                                <UniformGrid Columns="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerTopLeftShort}}"
                                                   VerticalAlignment="Center" MinWidth="26" Margin="0,0,4,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <hc:NumericUpDown Style="{StaticResource GeometryBox}" Minimum="0" Maximum="128"
                                                          Value="{Binding ClipRadiusTopLeft, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerTopLeft}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerTopRightShort}}"
                                                   VerticalAlignment="Center" MinWidth="26" Margin="0,0,4,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <hc:NumericUpDown Style="{StaticResource GeometryBox}" Minimum="0" Maximum="128"
                                                          Value="{Binding ClipRadiusTopRight, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerTopRight}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerBottomLeftShort}}"
                                                   VerticalAlignment="Center" MinWidth="26" Margin="0,0,4,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <hc:NumericUpDown Style="{StaticResource GeometryBox}" Minimum="0" Maximum="128"
                                                          Value="{Binding ClipRadiusBottomLeft, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerBottomLeft}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerBottomRightShort}}"
                                                   VerticalAlignment="Center" MinWidth="26" Margin="0,0,4,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <hc:NumericUpDown Style="{StaticResource GeometryBox}" Minimum="0" Maximum="128"
                                                          Value="{Binding ClipRadiusBottomRight, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCornerBottomRight}}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Expander>

                        <!-- Rating Badge Expander -->
                        <Expander Header="{extension:Lang Key={x:Static langs:LangKeys.OverlayLayerRatingBadge}}"
                                  Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerFont}}"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding RatingFontFamily, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerFontSize}}"
                                           Style="{StaticResource FieldLabel}" />
                                <hc:NumericUpDown Value="{Binding RatingFontSize}" Minimum="6" Maximum="72"
                                                  Width="90" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>

                        <!-- Title Text Expander -->
                        <Expander Header="{extension:Lang Key={x:Static langs:LangKeys.OverlayLayerTitleText}}"
                                  Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerFont}}"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TitleFontFamily, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerColour}}"
                                           Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Live Color Swatch -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            Background="{Binding TitleForegroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCurrentTitleColour}}" />

                                    <TextBox Grid.Column="1" VerticalAlignment="Center"
                                             Text="{Binding TitleForeground, UpdateSourceTrigger=LostFocus}"
                                             AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerTitleColourValue}}" />

                                    <Button Grid.Column="2" Padding="10,4" Margin="8,0,0,0"
                                            Style="{StaticResource ButtonDefault}"
                                            Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerPick}}"
                                            VerticalAlignment="Center"
                                            Click="OnPickTitleColourClicked"
                                            ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerChooseColour}}"
                                            AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerChooseTitleColour}}" />
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                           Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerColourHint}}" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerRotation}}"
                                           Style="{StaticResource FieldLabel}" />
                                <Slider Value="{Binding TitleRotationAngle}" Minimum="0" Maximum="360"
                                        TickFrequency="90" IsSnapToTickEnabled="False"
                                        AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerTitleRotationAutomation}}" />
                                <TextBlock Text="{Binding TitleRotationAngle, StringFormat={}{0:0}°}"
                                           Style="{StaticResource HintText}" />
                            </StackPanel>
                        </Expander>

                        <!-- Advanced Canvas Expander -->
                        <Expander Header="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerAdvancedCanvas}}"
                                  Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerAdvancedCanvasHint}}" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerDesignWidth}}"
                                           Style="{StaticResource FieldLabel}" />
                                <hc:NumericUpDown Value="{Binding DesignWidth}" Minimum="16" Maximum="2000"
                                                  Width="90" HorizontalAlignment="Left" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerDesignHeight}}"
                                           Style="{StaticResource FieldLabel}" />
                                <hc:NumericUpDown Value="{Binding DesignHeight}" Minimum="16" Maximum="2000"
                                                  Width="90" HorizontalAlignment="Left" />

                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerRootMargin}}"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RootMargin, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerRootMarginHint}}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Controls: Testing, Validation, Guided Submission & Actions -->
        <Grid Grid.Row="2" Margin="0,10,0,0"
              Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Preview Testing Controls -->
            <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerPreviewWith}}"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerSamplePoster}}"
                            Style="{StaticResource ButtonDefault}"
                            Padding="10,3" Margin="0,0,12,0"
                            Command="{Binding BrowseTestPosterCommand}" />

                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Rating}}"
                               VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBox Text="{Binding TestRating, UpdateSourceTrigger=PropertyChanged}"
                             Width="52" Margin="0,0,12,0" VerticalAlignment="Center"
                             AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerSampleRatingAutomation}}" />

                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Title}}"
                               VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBox Text="{Binding TestTitle, UpdateSourceTrigger=LostFocus}"
                             Width="180" Margin="0,0,12,0" VerticalAlignment="Center"
                             AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerSampleTitleAutomation}}" />

                    <CheckBox Content="{extension:Lang Key={x:Static langs:LangKeys.Rating}}"
                              IsChecked="{Binding ShowTestRating}"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerMockup}}"
                              IsChecked="{Binding ShowTestMockup}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Row 1: Validation Issues -->
            <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    MaxHeight="96">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ValidationSummary}"
                               VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,14,0" MinWidth="120"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ValidationIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left" Padding="2" Margin="0,1"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.FocusIssueCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Margin="0,0,6,0" MinWidth="52">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                                Value="{Binding Source={StaticResource FoliConLangs},
                                                                        Path=OverlayDesignerSeverityError}" />
                                                        <Setter Property="Foreground" Value="#FFC42B1C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                <Setter Property="Text"
                                                                        Value="{Binding Source={StaticResource FoliConLangs},
                                                                                Path=OverlayDesignerSeverityWarning}" />
                                                                <Setter Property="Foreground" Value="#FF9D5D00" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                       MaxWidth="820"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Row 2: Guided Submission Panel (after export) -->
            <Border Grid.Row="2" Margin="0,0,0,8" Padding="14" CornerRadius="8"
                    Visibility="{Binding IsSubmissionPanelOpen, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerShareHeading}}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Button DockPanel.Dock="Right" Content="✕" Padding="8,2"
                                Style="{StaticResource ButtonDefault}"
                                Command="{Binding DismissSubmissionCommand}"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerHideSteps}}"
                                AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerHideStepsAutomation}}" />
                    </DockPanel>

                    <TextBlock Text="{Binding SubmissionCheckMessage}" FontSize="11.5" Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <!-- Local Install & Open Folder Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerInstallLocally}}"
                                Padding="14,4" Margin="0,0,8,0"
                                Command="{Binding InstallLocallyCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerInstallLocallyTooltip}}" />
                        <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerOpenFolder}}"
                                Padding="14,4"
                                Style="{StaticResource ButtonDefault}"
                                Command="{Binding OpenExportFolderCommand}" />
                    </StackPanel>

                    <Separator Margin="0,0,0,8" />

                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerSubmitHeading}}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <StackPanel IsEnabled="{Binding CanSubmit}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox VerticalAlignment="Center" Margin="0,0,8,0"
                                      AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerStep1Automation}}" />
                            <TextBlock Text="1." FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerForkRepository}}"
                                    Style="{StaticResource ButtonDefault}"
                                    Padding="10,3" Margin="0,0,8,0"
                                    Command="{Binding OpenForkPageCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox VerticalAlignment="Center" Margin="0,0,8,0"
                                      AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerStep2Automation}}" />
                            <TextBlock Text="2." FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextBrush}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                        <Binding Source="{StaticResource FoliConLangs}"
                                                 Path="OverlayDesignerCopyFolderInto" />
                                        <Binding Path="SubmissionTargetPath" Mode="OneWay" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center" Margin="0,0,8,0"
                                      AutomationProperties.Name="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerStep3Automation}}" />
                            <TextBlock Text="3." FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <Button Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerOpenPullRequest}}"
                                    Style="{StaticResource ButtonDefault}"
                                    Padding="10,3"
                                    Command="{Binding OpenPullRequestPageCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Row 3: Modern Action Bar -->
            <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <!-- Leaves the designer -->
                <Button DockPanel.Dock="Right" Padding="16,6" Margin="8,0,0,0"
                        Style="{StaticResource ButtonDefault}"
                        Content="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerCloseDesigner}}"
                        Click="OnCloseClicked" />

                <!-- Export Package -->
                <Button DockPanel.Dock="Right" Padding="16,6" Margin="8,0,0,0"
                        Command="{Binding ExportPackageCommand}"
                        Style="{StaticResource ButtonPrimary}"
                        ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerExportPackageTooltip}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ExportGeometry}"
                              Fill="White"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerExportPackage}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Save Draft -->
                <Button DockPanel.Dock="Right" Padding="16,6"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding SaveDraftCommand}"
                        ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerSaveDraftTooltip}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SaveGeometry}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesignerSaveDraft}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
