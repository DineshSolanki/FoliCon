<hc:Window x:Class="FoliCon.Views.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:prism="http://prismlibrary.com/"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:viewModels="clr-namespace:FoliCon.ViewModels"
           xmlns:langs="clr-namespace:FoliCon.Properties.Langs"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:convertor="clr-namespace:FoliCon.Modules.Convertor"
           xmlns:extension="clr-namespace:FoliCon.Modules.Extension"
           xmlns:ui="clr-namespace:FoliCon.Modules.UI"
           xmlns:enums="clr-namespace:FoliCon.Models.Enums"
           xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
           mc:Ignorable="d"
           prism:ViewModelLocator.AutoWireViewModel="True"
           Title="{Binding Title}" Height="780" Width="980" MinWidth="880" MinHeight="660"
           WindowStartupLocation="CenterScreen" hc:WindowAttach.IsDragElement="True"
           SystemBackdropType="Mica"
           NonClientAreaBackground="{DynamicResource SecondaryRegionBrush}"
           NonClientAreaForeground="{DynamicResource PrimaryTextBrush}"
           CloseButtonHoverBackground="#E81123"
           OtherButtonHoverBackground="{DynamicResource SecondaryRegionBrush}"
           Icon="/Resources/icons/folicon Icon.ico"
           ui:FolderDragDropHelper.IsFileDragDropEnabled="True"
           ui:FolderDragDropHelper.FileDragDropTarget="{Binding}" AllowDrop="True"
           Background="{DynamicResource RegionBrush}"
           Foreground="{DynamicResource PrimaryTextBrush}"
           FontFamily="Segoe UI, Segoe UI Variable, Microsoft YaHei, Arial"
           TextOptions.TextFormattingMode="Display"
           RenderOptions.ClearTypeHint="Enabled"
           d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}" Closed="MainWindow_OnClosed">

    <Window.Resources>
        <convertor:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <convertor:BoolToPermissionTextConverter x:Key="BoolToPermissionTextConverter"/>
        <convertor:TextToVisibilityConverter x:Key="TextToVisibilityConverter" />
        <convertor:InvertedTextToVisibilityConverter x:Key="InvertedTextToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <hc:Boolean2VisibilityReConverter x:Key="InvertedBoolToVis" />
        <convertor:ThemeToDisplayConverter x:Key="ThemeToDisplayConverter" />

        <!-- Modern Section Header Label Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Segmented Pill Radio Style (For Mode Tabs) -->
        <Style x:Key="SegmentedRadioTabStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Media Source Selection Card Style -->
        <Style x:Key="MediaSourceRadioCardStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="2,0" />
                                <Border x:Name="SelectionIndicator" Grid.Column="1" Width="16" Height="16"
                                        CornerRadius="8" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="Transparent" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Ellipse x:Name="InnerDot" Width="8" Height="8"
                                             Fill="White" Visibility="Collapsed" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="InnerDot" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu Item Icon Container Style -->
        <Style x:Key="MenuIconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <convertor:ImageCacheConverter x:Key="ImageCacheConverter" />
        <hc:BindingProxy x:Key="Proxy" Value="{Binding}" />

        <!-- Queue Item DataTemplates for Modern FinalList -->
        <DataTemplate x:Key="QueueTitleColumnTemplate">
            <Grid VerticalAlignment="Center" Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Mini Poster Thumbnail with High-Quality Preview Popover -->
                <Border Grid.Column="0" Width="30" Height="42" CornerRadius="4"
                        ClipToBounds="True" Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border.ToolTip>
                        <ToolTip Style="{DynamicResource ToolTipDefault}">
                            <StackPanel MaxWidth="220" Margin="4">
                                <Border CornerRadius="6" ClipToBounds="True" MaxHeight="280" Margin="0,0,0,8"
                                        Background="{DynamicResource SecondaryRegionBrush}">
                                    <Image Source="{Binding Converter={StaticResource ImageCacheConverter}}"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Year, StringFormat='Release: {0}'}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"
                                           Visibility="{Binding Year, Converter={StaticResource TextToVisibilityConverter}}" />
                                <TextBlock Text="{Binding Folder}" FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Opacity="0.8" />
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>

                    <Grid>
                        <!-- Fallback icon when poster is not present or loading -->
                        <Path Data="{StaticResource FilmGeometry}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource SecondaryTextBrush}" Opacity="0.4"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Poster thumbnail: resolves remote URL, local poster, or folicon.ico in folder -->
                        <Image Source="{Binding Converter={StaticResource ImageCacheConverter}}"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <!-- Title & Subtitle (FolderName) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}" />
                    <TextBlock Text="{Binding FolderName}"
                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               Visibility="{Binding FolderName, Converter={StaticResource TextToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="QueueYearColumnTemplate">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" Padding="7,2"
                        Visibility="{Binding Year, Converter={StaticResource TextToVisibilityConverter}}">
                    <TextBlock Text="{Binding Year}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="—"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Opacity="0.35"
                           HorizontalAlignment="Center"
                           Visibility="{Binding Year, Converter={StaticResource InvertedTextToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="QueueRatingColumnTemplate">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#18F59E0B"
                        BorderBrush="#40F59E0B"
                        BorderThickness="1"
                        CornerRadius="4" Padding="7,2"
                        Visibility="{Binding Rating, Converter={StaticResource TextToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource SparkleStarGeometry}" Width="10" Height="10" Stretch="Uniform"
                              Fill="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Rating}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#F59E0B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="—"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Opacity="0.35"
                           HorizontalAlignment="Center"
                           Visibility="{Binding Rating, Converter={StaticResource InvertedTextToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="QueueFolderColumnTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3">
                <Path Data="{StaticResource CleanFolderGeometry}" Width="14" Height="14" Stretch="Uniform"
                      Fill="{DynamicResource SecondaryTextBrush}" Opacity="0.5"
                      Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Folder}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Folder}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Modern FinalList Item Container Style with Context Menu -->
        <Style x:Key="ModernFinalListItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemContainer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemContainer" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemContainer" Property="Background" Value="{DynamicResource ThirdlyRegionBrush}" />
                                <Setter TargetName="ItemContainer" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="ItemContainer" Property="BorderThickness" Value="3,0,0,1" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemContainer" Property="Background" Value="{DynamicResource ThirdlyRegionBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Open Folder in File Explorer"
                                  Command="{Binding Value.OpenFolderInExplorerCommand, Source={StaticResource Proxy}}"
                                  CommandParameter="{Binding Folder}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource CleanFolderGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy Folder Path"
                                  Command="{Binding Value.CopyFolderCommand, Source={StaticResource Proxy}}"
                                  CommandParameter="{Binding Folder}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource CopyGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remove from Queue"
                                  Command="{Binding Value.RemoveListItemCommand, Source={StaticResource Proxy}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource TrashGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Clear Queue"
                                  Command="{Binding Value.ClearListCommand, Source={StaticResource Proxy}}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource RefreshGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <hc:BusyIndicator Style="{StaticResource ModernBusyIndicatorStyle}" IsBusy="{Binding IsBusy}">
        <hc:BusyIndicator.BusyContentTemplate>
            <DataTemplate>
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding Path=DataContext.BusyIndicatorProperties.Title, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Path=DataContext.BusyIndicatorProperties.Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <ProgressBar Style="{DynamicResource ProgressBarSuccessStripe}"
                                 Value="{Binding Path=DataContext.BusyIndicatorProperties.Value, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                                 Maximum="{Binding Path=DataContext.BusyIndicatorProperties.Max, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                                 Height="10" Margin="0,0,0,16" />
                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.Cancel}}"
                            Style="{DynamicResource ButtonDefault}"
                            HorizontalAlignment="Center" Width="100" Height="32"
                            Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.DownloadCancelCommand}" />
                </StackPanel>
            </DataTemplate>
        </hc:BusyIndicator.BusyContentTemplate>

        <Grid Background="{DynamicResource RegionBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Row 0: Modern Header Toolbar / Menu -->
                <RowDefinition Height="Auto" />  <!-- Row 1: Folder Hero / Drop Card -->
                <RowDefinition Height="Auto" />  <!-- Row 2: Mode & Action Control Center -->
                <RowDefinition Height="*" />     <!-- Row 3: Results & Queue Data Grid -->
                <RowDefinition Height="Auto" />  <!-- Row 4: Modern Status Bar Footer -->
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: MODERN HEADER / APP TOOLBAR                                        -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- FoliCon Branding -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,16,0">
                        <Image Source="/Resources/icons/folicon Icon.png"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Width="22" Height="22" Margin="0,0,8,0" />
                        <TextBlock Text="FoliCon" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v5.3" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <!-- Main Navigation Menu -->
                    <Menu Grid.Column="1" IsMainMenu="True" Background="Transparent" VerticalAlignment="Center">
                        <!-- OVERLAYS MENU -->
                        <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.AboutOverlays}}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource PaletteGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                            <MenuItem x:Name="MenuOverlayStoreBtn" Command="{Binding OverlayStoreCommand}"
                                      Header="{extension:Lang Key={x:Static langs:LangKeys.OverlayStore}}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource StoreGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuOverlayDesignerBtn" Command="{Binding OverlayDesignerCommand}"
                                      Header="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesigner}}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource PaletteGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="Previewer" Command="{Binding ShowPreviewer}" Header="{extension:Lang Key={x:Static langs:LangKeys.Previewer}}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource EyeGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="MenuPosterIconConfigBtn" Header="{extension:Lang Key={x:Static langs:LangKeys.ChangePosterOverlay}}"
                                      Command="{Binding PosterIconConfigCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource SettingGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- TOOLS MENU -->
                        <MenuItem Header="Tools">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource WrenchGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                            <MenuItem x:Name="MenuCustomIconsbtn" Header="{extension:Lang Key={x:Static langs:LangKeys.HaveIcons}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.HaveIconsTooltip}}"
                                      Command="{Binding CustomIconsCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource CleanFolderGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuSubfolderProcessingConfigBtn" Header="{extension:Lang Key={x:Static langs:LangKeys.SubfolderProcessing}}"
                                      Command="{Binding SubfolderProcessingConfigCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource CleanFolderGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="MenuRExbtn" Header="{extension:Lang Key={x:Static langs:LangKeys.RestartExplorer}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.RestartExplorerTooltip}}"
                                      Command="{Binding RestartExCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource RefreshGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="MenuDeleteIconsbtn" Header="{extension:Lang Key={x:Static langs:LangKeys.DeleteIcons}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.DeleteIconsTooltip}}"
                                      Command="{Binding DeleteIconsCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource RemoveGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuDeleteMediaInfoBtn" Header="{extension:Lang Key={x:Static langs:LangKeys.DeleteMediaInfo}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.DeleteMediaInfoTooltip}}"
                                      Command="{Binding DeleteMediaInfoCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource RemoveGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- SETTINGS MENU -->
                        <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.Settings}}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource SettingGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>

                            <!-- ======================================================== -->
                            <!-- 1. ICON GENERATION & ARTWORK PREFERENCES                 -->
                            <!-- ======================================================== -->
                            <MenuItem x:Name="ChkIsRatingVisible"
                                      Header="{extension:Lang Key={x:Static langs:LangKeys.ShowRatingBadge}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.ShowRatingBadgeTooltip}}"
                                      IsCheckable="True" IsChecked="{Binding IsRatingVisible}" />

                            <MenuItem x:Name="ChkIsPosterOverlayVisible"
                                      Header="{extension:Lang Key={x:Static langs:LangKeys.UsePosterOverlay}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.PosterOverlayTooltip}}"
                                      IsCheckable="True" IsChecked="{Binding IsPosterMockupUsed}" />

                            <MenuItem x:Name="ChkPosterShown"
                                      Header="{extension:Lang Key={x:Static langs:LangKeys.AlwaysShowPosterWindow}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.ShowPosterWindowTooltip}}"
                                      IsCheckable="True" IsChecked="{Binding IsPosterWindowShown}" />

                            <MenuItem x:Name="ChkIgnoreAmbiguous"
                                      Header="{extension:Lang Key={x:Static langs:LangKeys.IgnoreAmbiguousTitle}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.AmbiguousTitleTooltip}}"
                                      IsCheckable="True" IsChecked="{Binding IsSkipAmbiguous}"
                                      IsEnabled="{Binding IsSkipAmbiguousEnabled}" />

                            <Separator />

                            <!-- ======================================================== -->
                            <!-- 2. FOLDER SCANNING & PROCESSING RULES                    -->
                            <!-- ======================================================== -->
                            <MenuItem x:Name="ChkProcessSelectedFolder"
                                      Header="{extension:Lang Key={x:Static langs:LangKeys.ProcessSelectedFolder}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.ProcessSelectedFolderTooltip}}"
                                      IsCheckable="True" IsChecked="{Binding ProcessSelectedFolder}" />

                            <MenuItem x:Name="ChkIncludeAlreadyProcessed"
                                      Header="{extension:Lang Key={x:Static langs:LangKeys.IncludeAlreadyProcessed}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.IncludeAlreadyProcessedTooltip}}"
                                      IsCheckable="True" IsChecked="{Binding IncludeAlreadyProcessed}" />

                            <Separator />

                            <!-- ======================================================== -->
                            <!-- 3. WINDOWS EXPLORER INTEGRATION                          -->
                            <!-- ======================================================== -->
                            <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.ExplorerIntegration}}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource CleanFolderGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                                <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.AddToContextMenu}}"
                                          Command="{Binding ExploreIntegrationCommand}" CommandParameter="True">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource CheckCircleGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.RemoveFromContextMenu}}"
                                          Command="{Binding ExploreIntegrationCommand}" CommandParameter="False">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource TrashGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>

                            <!-- ======================================================== -->
                            <!-- 4. APPEARANCE & LOCALIZATION (THEME & LANGUAGE)          -->
                            <!-- ======================================================== -->
                            <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.Theme}}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource PaletteGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                                <Border Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="14,12" Margin="4">
                                    <StackPanel Width="220">
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Theme}}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6" />
                                        <hc:ComboBox x:Name="CmbTheme" AutoComplete="True"
                                                     ItemsSource="{Binding Source={hc:EnumBindingSource {x:Type enums:FoliconThemes}}}"
                                                     IsEditable="False" SelectedItem="{Binding Path=Theme}"
                                                     Margin="0,0,0,12">
                                            <hc:ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ThemeToDisplayConverter}}" />
                                                </DataTemplate>
                                            </hc:ComboBox.ItemTemplate>
                                        </hc:ComboBox>

                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.ChangeLanguage}}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6" />
                                        <hc:ComboBox x:Name="CmbLanguage" AutoComplete="True"
                                                     ItemsSource="{Binding Source={hc:EnumBindingSource {x:Type enums:Languages}}}"
                                                     IsEditable="False" SelectedItem="{Binding Path=AppLanguage}"
                                                     SelectionChanged="CmbLanguage_OnSelectionChanged" />
                                    </StackPanel>
                                </Border>
                            </MenuItem>

                            <Separator />

                            <!-- ======================================================== -->
                            <!-- 5. PRIVACY & DIAGNOSTICS                                 -->
                            <!-- ======================================================== -->
                            <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.EnableErrorReporting}}"
                                      ToolTip="{extension:Lang Key={x:Static langs:LangKeys.EnableErrorReportingTip}}"
                                      IsCheckable="True" IsChecked="{Binding EnableErrorReporting}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource BlogsGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- ======================================================== -->
                            <!-- 6. SETUP WIZARD                                          -->
                            <!-- ======================================================== -->
                            <MenuItem x:Name="MenuSetupWizardBtn" Header="{extension:Lang Key={x:Static langs:LangKeys.SetupWizard}}"
                                      Command="{Binding SetupWizardCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource ModernWandGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- HELP MENU -->
                        <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.Help}}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource InfoGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                            </MenuItem.Icon>
                            <MenuItem x:Name="MenubtnHelp" Header="{extension:Lang Key={x:Static langs:LangKeys.HelpDocument}}"
                                      Command="hc:ControlCommands.OpenLink" CommandParameter="https://dineshsolanki.github.io/FoliCon-docs/">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource DocGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.CheckForUpdate}}" Command="{Binding UpdateCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource UpdateGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{extension:Lang Key={x:Static langs:LangKeys.About}}" Command="{Binding AboutCommand}" >
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource InfoGeometry}" Style="{StaticResource MenuIconPathStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <!-- Quick Action Shortcuts (Right Side) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource ButtonDefault}" Height="28" Padding="10,0" Margin="0,0,6,0"
                                Command="{Binding OverlayStoreCommand}" ToolTip="Browse community and official icon overlays">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource StoreGeometry}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Overlay Store" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource ButtonDefault}" Height="28" Padding="10,0"
                                Command="{Binding ShowPreviewer}" ToolTip="Preview folder icons on your system">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource EyeGeometry}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Previewer" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 1: FOLDER HERO & DROP TARGET CARD                                     -->
            <!-- ========================================================================= -->
            <ContentControl Grid.Row="1" Focusable="False" HorizontalContentAlignment="Stretch">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="MouseDoubleClick">
                        <hc:LaunchUriOrFileAction Path="{Binding SelectedFolder}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
                <Border Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="16,10,16,10"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SelectedFolderDClickCommand}" />
                    </Border.InputBindings>

                    <Grid>
                    <!-- State A: No Folder Selected (Welcoming Drop Zone) -->
                    <Grid Visibility="{Binding SelectedFolder, Converter={StaticResource InvertedTextToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Prominent Vibrant Folder Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                Background="{DynamicResource PrimaryBrush}"
                                Margin="0,0,14,0">
                            <Path Data="{StaticResource CleanFolderGeometry}" Width="22" Height="22" Stretch="Uniform"
                                  Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.BrowseFolderDropHere}}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Drag and drop any movies, TV series, or games directory here to begin"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{DynamicResource ButtonPrimary}"
                                Height="36" Padding="18,0"
                                Command="{Binding LoadCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CleanFolderGeometry}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="White" Margin="0,0,8,0" />
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.BrowseFolderDropHere}}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- State B: Folder Selected (Active Directory Banner) -->
                    <Grid Visibility="{Binding SelectedFolder, Converter={StaticResource TextToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                Background="{DynamicResource PrimaryBrush}"
                                Margin="0,0,14,0">
                            <Path Data="{StaticResource CleanFolderGeometry}" Width="22" Height="22" Stretch="Uniform"
                                  Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SELECTED DIRECTORY (Double-click card to open in Explorer)"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding SelectedFolder}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedFolder}" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Permission Indicator Pill -->
                        <Border Grid.Column="2" CornerRadius="12" Padding="10,4" Margin="12,0" VerticalAlignment="Center"
                                Background="{DynamicResource RegionBrush}"
                                BorderBrush="{Binding DirectoryPermissionsResult.CanWrite, Converter={StaticResource BoolToColorConverter}}"
                                BorderThickness="1">
                            <Border.ToolTip>
                                <TextBlock Text="{Binding DirectoryPermissionsResult.CanWrite, Converter={StaticResource BoolToPermissionTextConverter}}" />
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding DirectoryPermissionsResult.CanWrite, Converter={StaticResource BoolToColorConverter}}" />
                                <TextBlock Text="{Binding DirectoryPermissionsResult.CanWrite, Converter={StaticResource BoolToPermissionTextConverter}}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource ButtonDefault}"
                                    Height="34" Padding="12,0" Margin="0,0,6,0"
                                    Command="{Binding SelectedFolderDClickCommand}"
                                    ToolTip="Open folder in File Explorer">
                                <TextBlock Text="Open" />
                            </Button>
                            <Button Style="{DynamicResource ButtonPrimary}"
                                    Height="34" Padding="14,0"
                                    Command="{Binding LoadCommand}"
                                    ToolTip="Select a different directory">
                                <TextBlock Text="Change..." />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
                </Border>
            </ContentControl>

            <!-- ========================================================================= -->
            <!-- ROW 2: CONTROL CENTER (MODES & ACTIONS)                                   -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="2" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />  <!-- Left: Modes & Options Card -->
                    <ColumnDefinition Width="1*" />     <!-- Right: Action Center Card -->
                </Grid.ColumnDefinitions>

                <!-- CARD 1: Generation Mode & Source -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,6,0">
                    <StackPanel>
                        <!-- Section: Icon Mode -->
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.IconMode}}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        
                        <!-- Segmented Pill Selector for Icon Mode -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="RPoster" Style="{StaticResource SegmentedRadioTabStyle}"
                                         Command="{Binding IconModeChangedCommand}" CommandParameter="Poster"
                                         GroupName="IconMode" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource FilmGeometry}" Width="15" Height="15" Stretch="Uniform"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                          Margin="0,0,8,0" />
                                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Poster}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RProf" Style="{StaticResource SegmentedRadioTabStyle}"
                                         Command="{Binding IconModeChangedCommand}" CommandParameter="Professional"
                                         GroupName="IconMode">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource PaletteGeometry}" Width="15" Height="15" Stretch="Uniform"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                          Margin="0,0,8,0" />
                                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Professional}}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Section: Media Type / Search Mode -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2,0,10"
                                Visibility="{Binding IsSearchModeVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        
                        <StackPanel Visibility="{Binding IsSearchModeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.SearchMode}}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            
                            <!-- 2x2 Interactive Source Cards -->
                            <UniformGrid Columns="2" Rows="2">
                                <RadioButton x:Name="RMovie" Style="{StaticResource MediaSourceRadioCardStyle}"
                                             Command="{Binding SearchModeChangedCommand}" CommandParameter="Movie"
                                             GroupName="SearchMode" IsChecked="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource FilmGeometry}" Width="16" Height="16" Stretch="Uniform"
                                              Fill="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Movie}}" FontSize="13" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RTv" Style="{StaticResource MediaSourceRadioCardStyle}"
                                             Command="{Binding SearchModeChangedCommand}" CommandParameter="TV"
                                             GroupName="SearchMode">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource TvGeometry}" Width="16" Height="16" Stretch="Uniform"
                                              Fill="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.TV}}" FontSize="13" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RGame" Style="{StaticResource MediaSourceRadioCardStyle}"
                                             Command="{Binding SearchModeChangedCommand}" CommandParameter="Game"
                                             GroupName="SearchMode">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GamepadGeometry}" Width="16" Height="16" Stretch="Uniform"
                                              Fill="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Game}}" FontSize="13" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RAuto" Style="{StaticResource MediaSourceRadioCardStyle}"
                                             Command="{Binding SearchModeChangedCommand}"
                                             CommandParameter="Auto (Movies &amp; TV Shows)"
                                             GroupName="SearchMode">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource AutoSparklesGeometry}" Width="16" Height="16" Stretch="Uniform"
                                              Fill="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Auto}}" FontSize="13" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Section: Professional Mode Overview (Shown when Professional mode is selected) -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2,0,10"
                                Visibility="{Binding IsSearchModeVisible, Converter={StaticResource InvertedBoolToVis}}" />

                        <Border Visibility="{Binding IsSearchModeVisible, Converter={StaticResource InvertedBoolToVis}}"
                                Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Opacity="0.12" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Path Grid.Column="0" Data="{StaticResource PaletteGeometry}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Top"
                                      Margin="0,9,0,0" />

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DeviantArt Professional Mode"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Searches DeviantArt for handcrafted icon packs created by artists. Matched folders will receive high-resolution custom designed folder icons."
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Actions & Execution -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ACTIONS &amp; OPTIONS" Style="{StaticResource SectionHeaderStyle}" />

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- Primary CTA: Make Icons -->
                            <Button Style="{DynamicResource ButtonPrimary}"
                                    Height="48"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SearchAndMakeCommand}"
                                    IsEnabled="{Binding IsMakeEnabled}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource ModernWandGeometry}" Width="20" Height="20" Stretch="Uniform"
                                          Fill="White" Margin="0,0,10,0" />
                                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.MakeIcons}}"
                                               FontSize="15" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Quick Options Box -->
                            <Border Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Quick Generation Options" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                    <UniformGrid Columns="2" Margin="0,2">
                                        <CheckBox Content="{extension:Lang Key={x:Static langs:LangKeys.UsePosterOverlay}}"
                                                  IsChecked="{Binding IsPosterMockupUsed}" Margin="0,2"
                                                  ToolTip="{extension:Lang Key={x:Static langs:LangKeys.PosterOverlayTooltip}}" />
                                        <CheckBox Content="{extension:Lang Key={x:Static langs:LangKeys.ShowRatingBadge}}"
                                                  IsChecked="{Binding IsRatingVisible}" Margin="0,2"
                                                  ToolTip="{extension:Lang Key={x:Static langs:LangKeys.ShowRatingBadgeTooltip}}" />
                                        <CheckBox Content="{extension:Lang Key={x:Static langs:LangKeys.AlwaysShowPosterWindow}}"
                                                  IsChecked="{Binding IsPosterWindowShown}" Margin="0,2"
                                                  ToolTip="{extension:Lang Key={x:Static langs:LangKeys.ShowPosterWindowTooltip}}" />
                                        <CheckBox Content="{extension:Lang Key={x:Static langs:LangKeys.IgnoreAmbiguousTitle}}"
                                                  IsChecked="{Binding IsSkipAmbiguous}" IsEnabled="{Binding IsSkipAmbiguousEnabled}" Margin="0,2"
                                                  ToolTip="{extension:Lang Key={x:Static langs:LangKeys.AmbiguousTitleTooltip}}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Footer Callout Note -->
                        <TextBlock Grid.Row="2" Text="FoliCon queries TMDb, IGDB &amp; DeviantArt to automatically match and build folder icons."
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 3: RESULTS & QUEUE DATA GRID                                          -->
            <!-- ========================================================================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="16,0,16,10"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header Strip -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="7,7,0,0"
                            Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Media Queue &amp; Processed Items"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="• Double-click row to open in Explorer"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Height="24" Padding="8,0" Margin="0,0,8,0"
                                        Command="{Binding ClearListCommand}"
                                        ToolTip="Clear all items from queue">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FinalListViewData.Data.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource TrashGeometry}" Width="10" Height="10" Stretch="Uniform"
                                              Fill="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Clear" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Border Background="{DynamicResource SecondaryRegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding FinalListViewData.Data.Count, StringFormat='{}{0} items'}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main ListView Area -->
                    <Grid Grid.Row="1">
                        <ListView x:Name="FinalList"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ItemContainerStyle="{StaticResource ModernFinalListItemStyle}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  ItemsSource="{Binding FinalListViewData.Data}"
                                  SelectedItem="{Binding FinalListViewData.SelectedItem}"
                                  hc:Empty.ShowEmpty="False">
                            <ListView.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding ListViewDoubleClickCommand}" />
                            </ListView.InputBindings>
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="MouseDoubleClick">
                                    <hc:LaunchUriOrFileAction Path="{Binding FinalListViewData.SelectedItem.Folder}" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                            <b:Interaction.Behaviors>
                                <ui:ListViewClickSortBehavior/>
                            </b:Interaction.Behaviors>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{extension:Lang Key={x:Static langs:LangKeys.Title}}"
                                                    Width="340" CellTemplate="{StaticResource QueueTitleColumnTemplate}" />
                                    <GridViewColumn Header="{extension:Lang Key={x:Static langs:LangKeys.Year}}"
                                                    Width="85" CellTemplate="{StaticResource QueueYearColumnTemplate}" />
                                    <GridViewColumn Header="{extension:Lang Key={x:Static langs:LangKeys.Rating}}"
                                                    Width="90" CellTemplate="{StaticResource QueueRatingColumnTemplate}" />
                                    <GridViewColumn Header="{extension:Lang Key={x:Static langs:LangKeys.Folder}}"
                                                    Width="420" CellTemplate="{StaticResource QueueFolderColumnTemplate}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Custom Rich Empty State when List is Empty -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FinalListViewData.Data.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Width="60" Height="60" CornerRadius="14"
                                    Background="{DynamicResource SecondaryRegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource CleanFolderGeometry}" Width="28" Height="28" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No Media Folders in Queue"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="Choose a directory above and click 'Make Icons' to generate folder covers"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 4: MODERN STATUS BAR / FOOTER                                         -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="4" DataContext="{Binding StatusBarProperties}">
                <Border Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Col 0: Status & Activity -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Col 1: Center Progress Bar (stretches across center) -->
                            <ColumnDefinition Width="*" />
                            <!-- Col 2: Folders Processed Metric Pill -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Col 3: Icons Created Metric Pill -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Col 4: Network Status -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Status Indicator & Current Item -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{Binding AppStatus}"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AppStatusAdditional}"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="280" />
                        </StackPanel>

                        <!-- Active Center Progress Bar & Counter (Visible only when ProgressBarData.Value > 0) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProgressBarData.Value}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Modern Track Progress Bar -->
                            <Border Grid.Column="0" Height="8" CornerRadius="4"
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <ProgressBar Value="{Binding ProgressBarData.Value}"
                                             Maximum="{Binding ProgressBarData.Max}"
                                             Style="{DynamicResource ProgressBarFlat}"
                                             Foreground="{DynamicResource PrimaryBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             VerticalAlignment="Stretch" />
                            </Border>

                            <!-- Progress Metric Pill -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressBarData.Value}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text=" / " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding ProgressBarData.Max}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Folders Processed Metric Pill -->
                        <Border Grid.Column="2" Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.FoldersProcessed}}"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding ProcessedFolder}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text=" / " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding TotalFolders}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Icons Created Metric Pill -->
                        <Border Grid.Column="3" Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.IconsCreated}}"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding ProcessedIcon}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text=" / " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding TotalIcons}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Network Status Icon -->
                        <Image Grid.Column="4" Source="{Binding NetIcon}"
                               Width="20" Height="20" Stretch="Uniform"
                               VerticalAlignment="Center" ToolTip="Network Connectivity Status" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </hc:BusyIndicator>
</hc:Window>
