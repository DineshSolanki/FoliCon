<UserControl x:Class="FoliCon.Views.DeepLinkInstallDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:FoliCon.ViewModels"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:DeepLinkInstallDialogViewModel}"
             Width="460" MinHeight="260">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Border Background="{DynamicResource RegionBrush}" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header Badge & Target Name -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TargetType}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Deeplink Install Confirmation" Foreground="{DynamicResource ThirdTextBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding TargetName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Repository, StringFormat='Source: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 2. Color Palette Swatches (when Theme) -->
            <Border Grid.Row="1" Background="{DynamicResource SecondaryRegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="{Binding IsTheme, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Palette Preview" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Margin="6,0" Background="{Binding SwatchBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" ToolTip="Background" />
                        <Border Width="36" Height="36" CornerRadius="18" Margin="6,0" Background="{Binding SwatchCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" ToolTip="Card Surface" />
                        <Border Width="36" Height="36" CornerRadius="18" Margin="6,0" Background="{Binding SwatchPrimary}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" ToolTip="Primary Accent" />
                        <Border Width="36" Height="36" CornerRadius="18" Margin="6,0" Background="{Binding SwatchAccent}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" ToolTip="Highlight" />
                        <Border Width="36" Height="36" CornerRadius="18" Margin="6,0" Background="{Binding SwatchText}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" ToolTip="Text Color" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Security Signature Notice -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="🛡️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 4. Action Buttons (Focus defaults to Cancel to mitigate clickjacking) -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="90" Height="34"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        IsDefault="True" />

                <Button Content="Preview"
                        Command="{Binding PreviewCommand}"
                        Width="90" Height="34"
                        Margin="0,0,10,0"
                        Visibility="{Binding IsTheme, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Content="Install &amp; Apply"
                        Command="{Binding InstallCommand}"
                        Style="{StaticResource ButtonPrimary}"
                        Width="120" Height="34" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
