<UserControl x:Class="FoliCon.Views.PosterIconConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:modules="clr-namespace:FoliCon.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:langs="clr-namespace:FoliCon.Properties.Langs"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:extension="clr-namespace:FoliCon.Modules.Extension"
             xmlns:convertor="clr-namespace:FoliCon.Modules.Convertor"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance modules:PosterIconConfigViewModel}"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <hc:Boolean2VisibilityReConverter x:Key="InvertedBoolToVis" />

        <!-- Delete button with soft danger hover state -->
        <Style x:Key="DeleteIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <Path x:Name="IconPath"
                                  Data="{StaticResource TrashGeometry}"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource DangerBrush}"
                                  Opacity="0.8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25E54D42" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="IconPath" Property="Opacity" Value="1.0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40E54D42" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="IconPath" Property="Opacity" Value="1.0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay Card interactive container button -->
        <Style x:Key="OverlayCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="186" />
            <Setter Property="Height" Value="246" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource RegionBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding Title}" />
            <Setter Property="Height" Value="680" />
            <Setter Property="Width" Value="920" />
            <Setter Property="MinHeight" Value="520" />
            <Setter Property="MinWidth" Value="720" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Header Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 2. Main Gallery Workspace -->
            <RowDefinition Height="*" />
            <!-- 3. Bottom Footer Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Header & Action Toolbar -->
        <Grid Grid.Row="0" Margin="18,14,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- Leading Icon -->
                <ColumnDefinition Width="Auto" />  <!-- Title -->
                <ColumnDefinition Width="Auto" />  <!-- Count Badge -->
                <ColumnDefinition Width="*" />     <!-- Spacer -->
                <ColumnDefinition Width="Auto" />  <!-- Search Input -->
                <ColumnDefinition Width="Auto" />  <!-- Store Button -->
                <ColumnDefinition Width="Auto" />  <!-- Designer Button -->
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0"
                  Data="{StaticResource PaletteGeometry}"
                  Fill="{DynamicResource PrimaryBrush}"
                  Width="18" Height="18"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <!-- Overlays Count Badge -->
            <Border Grid.Column="2"
                    Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="10"
                    Padding="8,2"
                    VerticalAlignment="Center">
                <TextBlock Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocalizedFormat}">
                            <Binding Source="{StaticResource FoliConLangs}" Path="PosterIconOverlayCountFormat" />
                            <Binding Path="AvailableOverlays.Count" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Border>

            <!-- Search Filter Input -->
            <hc:TextBox Grid.Column="4"
                        Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        hc:InfoElement.Placeholder="{extension:Lang Key={x:Static langs:LangKeys.SearchOverlaysPlaceholder}}"
                        hc:InfoElement.ShowClearButton="True"
                        Height="32"
                        Width="190"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />

            <!-- Browse Store Button -->
            <Button Grid.Column="5"
                    Style="{StaticResource ButtonDefault}"
                    Command="{Binding BrowseOverlayStoreCommand}"
                    Height="32"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    ToolTip="Browse and install community overlays">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource StoreGeometry}"
                          Fill="{DynamicResource PrimaryTextBrush}"
                          Width="13" Height="13"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0" />
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayBrowseStore}}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Open Designer Button -->
            <Button Grid.Column="6"
                    Style="{StaticResource ButtonDefault}"
                    Command="{Binding CreateOverlayCommand}"
                    Height="32"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OverlayCreateOverlayTooltip}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource ModernWandGeometry}"
                          Fill="{DynamicResource PrimaryTextBrush}"
                          Width="13" Height="13"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0" />
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayDesigner}}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. Main Gallery Workspace Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="18,0,18,12">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AvailableOverlays}"
                              HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <!-- Interactive Card Button -->
                                <Button Style="{StaticResource OverlayCardButtonStyle}"
                                        Command="{Binding DataContext.IconOverlayChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding OverlayId}"
                                        ToolTip="{Binding DisplayName}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Top Status Row -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Preview Graphic -->
                                            <RowDefinition Height="*" />
                                            <!-- Name and Type Badge -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Active Pill Indicator -->
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource PrimaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource CheckCircleGeometry}"
                                                      Fill="White"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,4,0" />
                                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayActive}}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Preview Mockup Image -->
                                        <Border Grid.Row="1"
                                                Margin="4,6,4,8"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <Image Source="{Binding DemoIconPath}"
                                                   MaxWidth="136" MaxHeight="128"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <!-- Name & Type Pill -->
                                        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       MaxWidth="160" />

                                            <Border Margin="0,4,0,0"
                                                    Padding="6,1"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource RegionBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayBuiltIn}}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayCommunity}}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Visibility="{Binding IsBuiltIn, Converter={StaticResource InvertedBoolToVis}}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Delete button for custom user overlays (Top-Right) -->
                                <Button Style="{StaticResource DeleteIconButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,4,0"
                                        Visibility="{Binding IsBuiltIn, Converter={StaticResource InvertedBoolToVis}}"
                                        Command="{Binding DataContext.RemoveOverlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OverlayRemoveTooltip}}">
                                    <AutomationProperties.Name>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                            <Binding Source="{StaticResource FoliConLangs}"
                                                     Path="OverlayRemoveAutomation" />
                                            <Binding Path="DisplayName" />
                                        </MultiBinding>
                                    </AutomationProperties.Name>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 3. Bottom Footer Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{extension:Lang Key={x:Static langs:LangKeys.OverlayConfigFooter}}"
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding CloseCommand}"
                        Content="{extension:Lang Key={x:Static langs:LangKeys.Close}}"
                        Width="90" Height="32"
                        IsDefault="True"
                        IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
