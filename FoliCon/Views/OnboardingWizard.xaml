<UserControl x:Class="FoliCon.Views.OnboardingWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FoliCon.ViewModels"
             xmlns:langs="clr-namespace:FoliCon.Properties.Langs"
             xmlns:extension="clr-namespace:FoliCon.Modules.Extension"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="{DynamicResource RegionBrush}"
             d:DataContext="{d:DesignInstance viewModels:OnboardingWizardViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <hc:Boolean2VisibilityReConverter x:Key="InverseBoolToVis" />

        <!-- ===================================================================== -->
        <!-- STEP 0: WELCOME TEMPLATE                                              -->
        <!-- ===================================================================== -->
        <DataTemplate x:Key="WelcomeTemplate">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hero Icon & Title -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Border Width="54" Height="54" CornerRadius="12"
                            Background="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Center" Margin="0,4,0,12">
                        <Path Data="{StaticResource ModernWandGeometry}"
                              Width="26" Height="26" Stretch="Uniform"
                              Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingWelcomeTitle}}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingWelcome}}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               MaxWidth="540" LineHeight="18" />
                </StackPanel>

                <!-- 3 Feature Highlights Cards -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,6,0,18" Width="660">
                    <!-- Film Card -->
                    <Border Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="6,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource FilmGeometry}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingMoviesSeries}}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,3" />
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingMoviesSeriesDesc}}"
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Games Card -->
                    <Border Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="6,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource GamepadGeometry}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingVideoGames}}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,3" />
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingVideoGamesDesc}}"
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- DeviantArt Card -->
                    <Border Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="6,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource PaletteGeometry}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingCustomIcons}}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,3" />
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingCustomIconsDesc}}"
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Primary Call To Action -->
                <Button Grid.Row="2"
                        Command="{Binding DataContext.NextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingGetStarted}}"
                        Style="{StaticResource ButtonPrimary}"
                        Width="220" Height="38" FontSize="14" FontWeight="SemiBold"
                        HorizontalAlignment="Center" />

                <!-- All API Keys are Free Note -->
                <TextBlock Grid.Row="3"
                           Text="{extension:Lang Key={x:Static langs:LangKeys.AllApiKeysFree}}"
                           FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </Grid>
        </DataTemplate>

        <!-- ===================================================================== -->
        <!-- STEP 1: TMDB TEMPLATE (MOVIES & TV)                                   -->
        <!-- ===================================================================== -->
        <DataTemplate x:Key="TmdbTemplate">
            <StackPanel Margin="10,4">
                <!-- Section Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Path Data="{StaticResource FilmGeometry}"
                          Width="20" Height="20" Stretch="Uniform"
                          Fill="{DynamicResource PrimaryBrush}"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingTmdbStep}}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingTmdbInstructions}}"
                           TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,12" />

                <!-- Portal Helper Link -->
                <Border Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ExternalLinkGeometry}"
                              Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource PrimaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center" FontSize="12.5">
                            <Hyperlink Command="hc:ControlCommands.OpenLink"
                                       CommandParameter="{Binding TmdbPortalUrl}">
                                <Run Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingTmdbGetKey}}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Input Card -->
                <Border Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.TMDBAPIKey}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6" />
                        <hc:PasswordBox UnsafePassword="{Binding TmdbKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsSafeEnabled="False" Height="34" FontSize="13" />

                        <!-- Validation Controls -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Button Command="{Binding ValidateTmdbCommand}"
                                    Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingValidate}}"
                                    Style="{StaticResource ButtonPrimary}"
                                    Padding="16,6" Margin="0,0,12,0" />
                            <hc:LoadingCircle Visibility="{Binding IsTmdbValidating, Converter={StaticResource BoolToVis}}"
                                               Width="22" Height="22" Margin="0,0,10,0" />

                            <!-- Success Badge -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsTmdbValid, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource CheckCircleGeometry}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource SuccessBrush}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding TmdbValidationMessage}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Error Badge -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsTmdbValid, Converter={StaticResource InverseBoolToVis}}"
                                        VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding TmdbValidationMessage}"
                                           FontSize="12" TextWrapping="Wrap" MaxWidth="380"
                                           Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ===================================================================== -->
        <!-- STEP 2: IGDB TEMPLATE (VIDEO GAMES)                                   -->
        <!-- ===================================================================== -->
        <DataTemplate x:Key="IgdbTemplate">
            <StackPanel Margin="10,4">
                <!-- Section Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Path Data="{StaticResource GamepadGeometry}"
                          Width="20" Height="20" Stretch="Uniform"
                          Fill="{DynamicResource PrimaryBrush}"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingIgdbStep}}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingIgdbInstructions}}"
                           TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,12" />

                <!-- Portal Helper Link -->
                <Border Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ExternalLinkGeometry}"
                              Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource PrimaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center" FontSize="12.5">
                            <Hyperlink Command="hc:ControlCommands.OpenLink"
                                       CommandParameter="{Binding IgdbPortalUrl}">
                                <Run Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingIgdbGetKey}}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Input Card -->
                <Border Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.ClientID}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding IgdbClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" FontSize="13" Margin="0,0,0,10" />

                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.ClientSecret}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                        <hc:PasswordBox UnsafePassword="{Binding IgdbClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsSafeEnabled="False" Height="34" FontSize="13" />

                        <!-- Validation Controls -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Button Command="{Binding ValidateIgdbCommand}"
                                    Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingValidate}}"
                                    Style="{StaticResource ButtonPrimary}"
                                    Padding="16,6" Margin="0,0,12,0" />
                            <hc:LoadingCircle Visibility="{Binding IsIgdbValidating, Converter={StaticResource BoolToVis}}"
                                               Width="22" Height="22" Margin="0,0,10,0" />

                            <!-- Success Badge -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsIgdbValid, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource CheckCircleGeometry}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource SuccessBrush}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding IgdbValidationMessage}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Error Badge -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsIgdbValid, Converter={StaticResource InverseBoolToVis}}"
                                        VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding IgdbValidationMessage}"
                                           FontSize="12" TextWrapping="Wrap" MaxWidth="380"
                                           Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ===================================================================== -->
        <!-- STEP 3: DEVIANTART TEMPLATE (ARTIST ICONS)                            -->
        <!-- ===================================================================== -->
        <DataTemplate x:Key="DeviantArtTemplate">
            <StackPanel Margin="10,4">
                <!-- Section Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Path Data="{StaticResource PaletteGeometry}"
                          Width="20" Height="20" Stretch="Uniform"
                          Fill="{DynamicResource PrimaryBrush}"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingDeviantArtStep}}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingDeviantArtAuthInstructions}}"
                           TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,12" />

                <!-- Mode Selection -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingDeviantArtBuiltIn}}"
                                 IsChecked="{Binding IsDeviantArtBuiltInMode}"
                                 GroupName="DeviantArtMode" Margin="0,0,18,0" FontSize="13" FontWeight="SemiBold" />
                    <RadioButton Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingDeviantArtCustom}}"
                                 IsChecked="{Binding IsDeviantArtCustomMode}"
                                 GroupName="DeviantArtMode" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Built-In OAuth PKCE Mode -->
                <Border Visibility="{Binding IsDeviantArtBuiltInMode, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                            <Button Command="{Binding ConnectDeviantArtCommand}"
                                    Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingConnectDeviantArt}}"
                                    Style="{StaticResource ButtonPrimary}"
                                    Padding="18,7" Margin="0,0,14,0" FontSize="13" />
                            <hc:LoadingCircle Visibility="{Binding IsDeviantArtConnecting, Converter={StaticResource BoolToVis}}"
                                               Width="22" Height="22" Margin="0,0,10,0" />

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsDeviantArtConnected, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource CheckCircleGeometry}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource SuccessBrush}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding DeviantArtConnectionStatus}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Error Message if Any -->
                        <TextBlock Text="{Binding DeviantArtConnectionMessage}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="520"
                                   Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding HasDeviantArtConnectionMessage, Converter={StaticResource BoolToVis}}" />

                        <!-- Watcher Option -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsDeviantArtWatchEnabled}"
                                          Content="{extension:Lang Key={x:Static langs:LangKeys.DeviantArtWatchScopeLabel}}"
                                          FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.DeviantArtWatchScopeDescription}}"
                                           TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="22,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Custom Credentials Mode -->
                <Border Visibility="{Binding IsDeviantArtCustomCredentialsVisible, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingDeviantArtCustomInstructions}}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" />

                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.ClientID}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DeviantArtCustomClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" FontSize="13" Margin="0,0,0,10" />

                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.ClientSecret}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                        <hc:PasswordBox UnsafePassword="{Binding DeviantArtCustomClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsSafeEnabled="False" Height="34" FontSize="13" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                            <Button Command="{Binding ConnectDeviantArtCommand}"
                                    Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingDeviantArtValidateConnect}}"
                                    Style="{StaticResource ButtonPrimary}"
                                    Padding="16,6" Margin="0,0,12,0" />
                            <hc:LoadingCircle Visibility="{Binding IsDeviantArtConnecting, Converter={StaticResource BoolToVis}}"
                                               Width="22" Height="22" Margin="0,0,10,0" />

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsDeviantArtConnected, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center">
                                <Path Data="{StaticResource CheckCircleGeometry}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource SuccessBrush}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding DeviantArtConnectionStatus}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding DeviantArtConnectionMessage}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="520"
                                   Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding HasDeviantArtConnectionMessage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ===================================================================== -->
        <!-- STEP 4: SUMMARY TEMPLATE                                              -->
        <!-- ===================================================================== -->
        <DataTemplate x:Key="SummaryTemplate">
            <StackPanel Margin="14,10" HorizontalAlignment="Center" Width="600">
                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Path Data="{StaticResource CheckCircleGeometry}"
                          Width="32" Height="32" Stretch="Uniform"
                          Fill="{DynamicResource SuccessBrush}"
                          HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingSummary}}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 3 Service Summary Cards -->
                <StackPanel Margin="0,0,0,18">
                    <!-- TMDB Status Row -->
                    <Border Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="14,10" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource FilmGeometry}" Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingTmdbServiceName}}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Configured Pill -->
                            <Border DockPanel.Dock="Right" Background="#144CAF50" BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,3"
                                    Visibility="{Binding IsTmdbConfigured, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingConfigured}}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                            <!-- Skipped Pill -->
                            <Border DockPanel.Dock="Right" Background="#14FF9800" BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,3"
                                    Visibility="{Binding IsTmdbConfigured, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingSkipped}}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- IGDB Status Row -->
                    <Border Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="14,10" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GamepadGeometry}" Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingIgdbServiceName}}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border DockPanel.Dock="Right" Background="#144CAF50" BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,3"
                                    Visibility="{Binding IsIgdbConfigured, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingConfigured}}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                            <Border DockPanel.Dock="Right" Background="#14FF9800" BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,3"
                                    Visibility="{Binding IsIgdbConfigured, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingSkipped}}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- DeviantArt Status Row -->
                    <Border Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="14,10">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource PaletteGeometry}" Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingDeviantArtServiceName}}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border DockPanel.Dock="Right" Background="#144CAF50" BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,3"
                                    Visibility="{Binding IsDeviantArtConfigured, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingConfigured}}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                            <Border DockPanel.Dock="Right" Background="#14FF9800" BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,3"
                                    Visibility="{Binding IsDeviantArtConfigured, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnboardingSkipped}}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Footer Hint -->
                <TextBlock TextWrapping="Wrap" FontSize="12" TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{extension:Lang Key={x:Static langs:LangKeys.AllApiKeysFree}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding Title}" />
            <Setter Property="Width" Value="840" />
            <Setter Property="Height" Value="630" />
            <Setter Property="MinWidth" Value="780" />
            <Setter Property="MinHeight" Value="580" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Background="{DynamicResource RegionBrush}" Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Row 0: StepBar Indicator -->
            <RowDefinition Height="*" />     <!-- Row 1: Active Step Content Card -->
            <RowDefinition Height="Auto" />  <!-- Row 2: Navigation Buttons Footer -->
        </Grid.RowDefinitions>

        <!-- Step Indicator -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="12,8"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <hc:StepBar StepIndex="{Binding CurrentStep}">
                <hc:StepBarItem Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingGetStarted}}"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OnboardingGetStarted}}" />
                <hc:StepBarItem Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingTmdbStep}}"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OnboardingTmdbStep}}" />
                <hc:StepBarItem Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingIgdbStep}}"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OnboardingIgdbStep}}" />
                <hc:StepBarItem Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingDeviantArtStep}}"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OnboardingDeviantArtStep}}" />
                <hc:StepBarItem Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingSummary}}"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.OnboardingSummary}}" />
            </hc:StepBar>
        </Border>

        <!-- Content Card: active step's template rendered in elevated container -->
        <Border Grid.Row="1"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="18,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource WelcomeTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TmdbTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                    <Setter Property="ContentTemplate" Value="{StaticResource IgdbTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DeviantArtTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SummaryTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Border>

        <!-- Navigation Buttons Footer -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <!-- Close / Exit Wizard -->
            <Button DockPanel.Dock="Left"
                    Command="{Binding CloseDialogCommand}" CommandParameter="false"
                    Content="{extension:Lang Key={x:Static langs:LangKeys.Close}}"
                    Style="{StaticResource ButtonDefault}"
                    Padding="16,6" Height="36" />

            <!-- Next / Finish Action -->
            <Button DockPanel.Dock="Right"
                    Command="{Binding NextCommand}"
                    Content="{Binding NextButtonText}"
                    Style="{StaticResource ButtonPrimary}"
                    Padding="22,6" Height="36" Margin="8,0,0,0"
                    Visibility="{Binding CanGoNext, Converter={StaticResource BoolToVis}}" />

            <!-- Skip Step Action -->
            <Button DockPanel.Dock="Right"
                    Command="{Binding SkipCommand}"
                    Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingSkip}}"
                    Style="{StaticResource ButtonDefault}"
                    Padding="16,6" Height="36" Margin="8,0,0,0"
                    Visibility="{Binding CanGoNext, Converter={StaticResource BoolToVis}}" />

            <!-- Back Action -->
            <Button DockPanel.Dock="Right"
                    Command="{Binding BackCommand}"
                    Content="{extension:Lang Key={x:Static langs:LangKeys.OnboardingBack}}"
                    Style="{StaticResource ButtonDefault}"
                    Padding="16,6" Height="36"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" />
        </DockPanel>
    </Grid>
</UserControl>
