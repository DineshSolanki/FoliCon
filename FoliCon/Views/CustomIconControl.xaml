<UserControl x:Class="FoliCon.Views.CustomIconControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FoliCon.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:langs="clr-namespace:FoliCon.Properties.Langs"
             xmlns:extension="clr-namespace:FoliCon.Modules.Extension"
             xmlns:ui="clr-namespace:FoliCon.Modules.UI"
             xmlns:convertor="clr-namespace:FoliCon.Modules.Convertor"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:CustomIconControlViewModel}"
             Background="Transparent"
             prism:ViewModelLocator.AutoWireViewModel="True"
             AllowDrop="True">
    <UserControl.Resources>
        <convertor:CustomIconPathConverter x:Key="CustomIconPathConverter" />
        <convertor:IndexDisplayConverter x:Key="IndexDisplayConverter" />
        <convertor:TextToVisibilityConverter x:Key="TextToVis" />
        <convertor:InvertedTextToVisibilityConverter x:Key="InvertedTextToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding Title}" />
            <Setter Property="Height" Value="660" />
            <Setter Property="Width" Value="880" />
            <Setter Property="MinHeight" Value="540" />
            <Setter Property="MinWidth" Value="740" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
        </Style>
    </prism:Dialog.WindowStyle>

    <hc:BusyIndicator IsBusy="{Binding IsBusy}">
        <hc:BusyIndicator.BusyContent>
            <Border Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28,20">
                <StackPanel HorizontalAlignment="Center">
                    <hc:LoadingCircle Width="36" Height="36" Margin="0,0,0,14" />
                    <TextBlock FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} ({1}/{2})">
                                <Binding Path="BusyContent" />
                                <Binding Path="Index" />
                                <Binding Path="TotalIcons" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button Style="{StaticResource ButtonDanger}"
                            Content="{extension:Lang Key={x:Static langs:LangKeys.StopSearching}}"
                            Command="{Binding StopSearchCommand}"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            Height="32" Padding="18,0" />
                </StackPanel>
            </Border>
        </hc:BusyIndicator.BusyContent>

        <Grid Background="{DynamicResource RegionBrush}" Margin="16,14">
            <Grid.RowDefinitions>
                <!-- Top Instruction & Status Bar -->
                <RowDefinition Height="Auto" />
                <!-- Dual Workspaces (Folders vs Icons) -->
                <RowDefinition Height="*" />
                <!-- Bottom Action Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Top Instruction Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="{StaticResource AutoSparklesGeometry}"
                          Fill="{DynamicResource PrimaryBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0" />

                    <TextBlock Grid.Column="1"
                               Text="{extension:Lang Key={x:Static langs:LangKeys.CustomIconInstructions}}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 2. Dual Workspaces: Folders (Left) and Icons (Right) -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <!-- Folders Column -->
                    <ColumnDefinition Width="*" />
                    <!-- Column Gutter -->
                    <ColumnDefinition Width="14" />
                    <!-- Icons Column -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Folders -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Panel Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Drop / Browse Button -->
                            <RowDefinition Height="Auto" />
                            <!-- Items List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Title, Count, Clear Button -->
                        <Grid Grid.Row="0" Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource FolderGeometry}"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />

                            <TextBlock Grid.Column="1"
                                       Text="{extension:Lang Key={x:Static langs:LangKeys.Folders}}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Folder Count Badge -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0">
                                <TextBlock Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                            <Binding Source="{StaticResource FoliConLangs}" Path="FolderCountFormat" />
                                            <Binding Path="Directories.Count" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>

                            <!-- Clear Folders Button -->
                            <Button Grid.Column="3"
                                    Style="{StaticResource ButtonIcon}"
                                    Command="{Binding ClearFoldersCommand}"
                                    hc:IconElement.Geometry="{StaticResource TrashGeometry}"
                                    hc:IconElement.Width="12"
                                    hc:IconElement.Height="12"
                                    Width="26" Height="26"
                                    Padding="0"
                                    ToolTip="{extension:Lang Key={x:Static langs:LangKeys.ClearFoldersTooltip}}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Browse / Drop Target Button -->
                        <Button x:Name="FolderButton"
                                Grid.Row="1"
                                Style="{StaticResource ButtonDefault}"
                                HorizontalAlignment="Stretch"
                                Height="46"
                                Padding="12,0"
                                Margin="0,0,0,10"
                                Command="{Binding LoadDirectory}"
                                ui:FolderDragDropHelper.IsFileDragDropEnabled="True"
                                ui:FolderDragDropHelper.FileDragDropTarget="{Binding}"
                                ToolTip="{Binding SelectedDirectory}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0"
                                      Data="{StaticResource FolderGeometry}"
                                      Fill="{DynamicResource PrimaryTextBrush}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />

                                <!-- Placeholder when null/empty -->
                                <TextBlock Grid.Column="1"
                                           Text="{extension:Lang Key={x:Static langs:LangKeys.BrowseFolderDropHere}}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SelectedDirectory, Converter={StaticResource InvertedTextToVis}}" />

                                <!-- Populated folder path -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedDirectory}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SelectedDirectory, Converter={StaticResource TextToVis}}" />

                                <Border Grid.Column="2"
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Browse}}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Folders ListBox -->
                        <ListBox x:Name="FoldersList"
                                 Grid.Row="2"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 AllowDrop="True"
                                 IsManipulationEnabled="True"
                                 dd:DragDrop.IsDragSource="True"
                                 dd:DragDrop.DropHandler="{Binding ReOrderDropHandler}"
                                 dd:DragDrop.IsDropTarget="True"
                                 SelectionMode="Extended"
                                 ui:RowNumberHelper.ShowRowNumbers="True"
                                 ItemsSource="{Binding Path=Directories, UpdateSourceTrigger=PropertyChanged}"
                                 ui:FolderDragDropHelper.IsFileDragDropEnabled="True"
                                 ui:FolderDragDropHelper.FileDragDropTarget="{Binding}"
                                 hc:Empty.ShowEmpty="True"
                                 Background="{DynamicResource RegionBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1">
                            <i:Interaction.Triggers>
                                <i:KeyTrigger Key="Delete">
                                    <i:InvokeCommandAction CommandParameter="{Binding ElementName=FoldersList, Path=SelectedItems}"
                                                           Command="{Binding KeyPressFolderList}" />
                                </i:KeyTrigger>
                            </i:Interaction.Triggers>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <!-- Index Badge -->
                                            <ColumnDefinition Width="32" />
                                            <!-- Folder Icon -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Folder Name -->
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Row Index -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Path=(ui:RowNumberHelper.RowIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <!-- Folder Icon Box -->
                                        <Border Grid.Column="1"
                                                Width="26" Height="26"
                                                CornerRadius="5"
                                                Background="{DynamicResource SecondaryRegionBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource FolderGeometry}"
                                                  Fill="{DynamicResource PrimaryBrush}"
                                                  Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Folder Name -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="12.5" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Right Panel: Matching Icons -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Panel Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Drop / Browse Button -->
                            <RowDefinition Height="Auto" />
                            <!-- Items List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Title, Count, Clear Button -->
                        <Grid Grid.Row="0" Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource PaletteGeometry}"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />

                            <TextBlock Grid.Column="1"
                                       Text="{extension:Lang Key={x:Static langs:LangKeys.Icons}}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Icon Count Badge -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0">
                                <TextBlock Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                            <Binding Source="{StaticResource FoliConLangs}" Path="IconCountFormat" />
                                            <Binding Path="Icons.Count" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>

                            <!-- Clear Icons Button -->
                            <Button Grid.Column="3"
                                    Style="{StaticResource ButtonIcon}"
                                    Command="{Binding ClearIconsCommand}"
                                    hc:IconElement.Geometry="{StaticResource TrashGeometry}"
                                    hc:IconElement.Width="12"
                                    hc:IconElement.Height="12"
                                    Width="26" Height="26"
                                    Padding="0"
                                    ToolTip="{extension:Lang Key={x:Static langs:LangKeys.ClearIconsTooltip}}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Browse / Drop Target Button -->
                        <Button x:Name="IconButton"
                                Grid.Row="1"
                                Style="{StaticResource ButtonDefault}"
                                HorizontalAlignment="Stretch"
                                Height="46"
                                Padding="12,0"
                                Margin="0,0,0,10"
                                Command="{Binding LoadIcons}"
                                ui:FolderDragDropHelper.IsFileDragDropEnabled="True"
                                ui:FolderDragDropHelper.FileDragDropTarget="{Binding}"
                                ToolTip="{Binding SelectedIconsDirectory}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0"
                                      Data="{StaticResource PhotoGalleryGeometry}"
                                      Fill="{DynamicResource PrimaryTextBrush}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />

                                <!-- Placeholder when null/empty -->
                                <TextBlock Grid.Column="1"
                                           Text="{extension:Lang Key={x:Static langs:LangKeys.BrowseIconsDropHere}}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SelectedIconsDirectory, Converter={StaticResource InvertedTextToVis}}" />

                                <!-- Populated icons path -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedIconsDirectory}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SelectedIconsDirectory, Converter={StaticResource TextToVis}}" />

                                <Border Grid.Column="2"
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Browse}}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Icons ListBox -->
                        <ListBox x:Name="IconsList"
                                 Grid.Row="2"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 AllowDrop="True"
                                 IsManipulationEnabled="True"
                                 dd:DragDrop.IsDragSource="True"
                                 dd:DragDrop.DropHandler="{Binding ReOrderDropHandler}"
                                 dd:DragDrop.IsDropTarget="True"
                                 SelectionMode="Extended"
                                 ui:RowNumberHelper.ShowRowNumbers="True"
                                 ItemsSource="{Binding Path=Icons, UpdateSourceTrigger=PropertyChanged}"
                                 ui:FolderDragDropHelper.IsFileDragDropEnabled="True"
                                 ui:FolderDragDropHelper.FileDragDropTarget="{Binding}"
                                 hc:Empty.ShowEmpty="True"
                                 Background="{DynamicResource RegionBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1">
                            <i:Interaction.Triggers>
                                <i:KeyTrigger Key="Delete">
                                    <i:InvokeCommandAction CommandParameter="{Binding ElementName=IconsList, Path=SelectedItems}"
                                                           Command="{Binding KeyPressIconsList}" />
                                </i:KeyTrigger>
                            </i:Interaction.Triggers>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <!-- Index Badge -->
                                            <ColumnDefinition Width="32" />
                                            <!-- Icon Thumbnail Preview -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Icon File Name -->
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Row Index -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Path=(ui:RowNumberHelper.RowIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <!-- Icon Thumbnail Box -->
                                        <Border Grid.Column="1"
                                                Width="26" Height="26"
                                                CornerRadius="5"
                                                Background="{DynamicResource SecondaryRegionBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <!-- Fallback vector icon -->
                                                <Path Data="{StaticResource PaletteGeometry}"
                                                      Fill="{DynamicResource SecondaryTextBrush}"
                                                      Width="13" Height="13"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />

                                                <!-- Actual Decoded Icon -->
                                                <Image Width="22" Height="22"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource CustomIconPathConverter}">
                                                            <Binding Path="" />
                                                            <Binding Path="DataContext.SelectedIconsDirectory"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <!-- Icon Name -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="12.5" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Bottom Action Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Options (Checkbox) -->
                        <ColumnDefinition Width="*" />
                        <!-- Action Buttons -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Exact Match Option Toggle Switch -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource ToggleButtonSwitch}"
                                      IsChecked="{Binding KeepExactOnly}"
                                      VerticalAlignment="Center" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.OnlyKeepExactMatches}}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>

                    <!-- Undo & Apply Buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Undo Button -->
                        <Button Style="{StaticResource ButtonDefault}"
                                Command="{Binding UndoIcons}"
                                IsEnabled="{Binding IsUndoEnable}"
                                Height="36"
                                Padding="16,0"
                                Margin="0,0,10,0"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.UndoApplyTooltip}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource RefreshGeometry}"
                                      Fill="{DynamicResource PrimaryTextBrush}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Undo}}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Apply Button -->
                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding Apply}"
                                Height="36"
                                Padding="20,0"
                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.ApplyIconsTooltip}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource CheckCircleGeometry}"
                                      Fill="White"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.Apply}}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </hc:BusyIndicator>
</UserControl>