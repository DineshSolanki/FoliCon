<UserControl x:Class="FoliCon.Views.SubfolderProcessing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:FoliCon.ViewModels"
             xmlns:convertor="clr-namespace:FoliCon.Modules.Convertor"
             xmlns:extension="clr-namespace:FoliCon.Modules.Extension"
             xmlns:langs="clr-namespace:FoliCon.Properties.Langs"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="Transparent"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:SubfolderProcessingViewModel}">
    <UserControl.Resources>
        <convertor:RegexValidationConverter x:Key="RegexValidationConverter" />
        <hc:Boolean2BooleanReConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <hc:Boolean2VisibilityReConverter x:Key="InverseBoolToVis" />

        <!-- Theme-adaptive Regex validating TextBox style -->
        <Style x:Key="ValidatingTextBoxExtend" BasedOn="{StaticResource TextBoxPlusBaseStyle}" TargetType="hc:TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource RegexValidationConverter}">
                            <Binding Path="Text" RelativeSource="{RelativeSource Self}" />
                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type DataGridRow}}" Path="Item.Regex" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <DataTrigger Value="False">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource RegexValidationConverter}">
                            <Binding Path="Text" RelativeSource="{RelativeSource Self}" />
                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type DataGridRow}}" Path="Item.Regex" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Refined rounded delete button with soft danger hover state -->
        <Style x:Key="DeleteIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Path x:Name="IconPath"
                                  Data="{StaticResource TrashGeometry}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource DangerBrush}"
                                  Opacity="0.75"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22E54D42" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#44E54D42" />
                                <Setter TargetName="IconPath" Property="Opacity" Value="1.0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38E54D42" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="IconPath" Property="Opacity" Value="1.0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding Title}" />
            <Setter Property="Height" Value="620" />
            <Setter Property="Width" Value="760" />
            <Setter Property="MinHeight" Value="520" />
            <Setter Property="MinWidth" Value="640" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <!-- 0. Master Switch & Depth Config Card -->
            <RowDefinition Height="Auto" />
            <!-- 1. Add Pattern Card -->
            <RowDefinition Height="Auto" />
            <!-- 2. Patterns DataGrid Card -->
            <RowDefinition Height="*" />
            <!-- 3. Footer Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Master Switch & Depth Configuration Card -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="16,14,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Master Toggle Switch & Description -->
                    <ColumnDefinition Width="*" />
                    <!-- Divider -->
                    <ColumnDefinition Width="20" />
                    <!-- Max Depth NumericUpDown -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Master Feature Switch -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource ToggleButtonSwitch}"
                                      IsChecked="{Binding SubfolderProcessingEnabled}"
                                      VerticalAlignment="Center" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.EnableSubfolderProcessing}}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.SubfolderProcessingDescription}}"
                               FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="48,4,0,0" />
                </StackPanel>

                <!-- Max Search Depth -->
                <Border Grid.Column="2"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        ToolTip="{extension:Lang Key={x:Static langs:LangKeys.MaxDepthTooltip}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.MaxDepth}}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.MaxDepthHint}}"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <hc:NumericUpDown Value="{Binding SubfolderDepthLimit}"
                                          Minimum="0" Maximum="100"
                                          Width="80" Height="28"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 1. Add Pattern Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="16,0,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Pattern Input Box -->
                <hc:TextBox x:Name="TxtPattern"
                            Grid.Column="0"
                            Text="{Binding NewPatternText, UpdateSourceTrigger=PropertyChanged}"
                            hc:InfoElement.Placeholder="{extension:Lang Key={x:Static langs:LangKeys.EnterValidRegexPlaceholder}}"
                            hc:InfoElement.ShowClearButton="True"
                            Style="{StaticResource TextBoxExtend}"
                            Height="34"
                            FontSize="12.5" />

                <!-- Add Pattern Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding AddCommand}"
                        CommandParameter="{Binding ElementName=TxtPattern, Path=Text}"
                        Height="34"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource AutoSparklesGeometry}"
                              Fill="White"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Margin="0,0,6,0" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.AddPattern}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Matching Patterns DataGrid Card -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="16,0,16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Card Header -->
                    <RowDefinition Height="Auto" />
                    <!-- DataGrid Table -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Card Header -->
                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="{StaticResource SettingGeometry}"
                          Fill="{DynamicResource PrimaryBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />

                    <TextBlock Grid.Column="1"
                               Text="{extension:Lang Key={x:Static langs:LangKeys.MatchingPatterns}}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="2"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                    <Binding Source="{StaticResource FoliConLangs}" Path="PatternCountFormat" />
                                    <Binding Path="PatternsList.Count" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Patterns Table -->
                <DataGrid x:Name="DgPatterns"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding PatternsList}"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          HeadersVisibility="Column"
                          RowHeight="40"
                          Background="{DynamicResource RegionBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource PrimaryTextColor}" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource PrimaryTextColor}" />
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!-- Pattern Column -->
                        <DataGridTemplateColumn Header="{extension:Lang Key={x:Static langs:LangKeys.Pattern}}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <hc:TextBox Text="{Binding Regex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsReadOnly="{Binding IsReadOnly}"
                                                    Height="28" FontSize="12.5"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource TextBoxExtend}" />
                                        <!-- Read-Only / Default Badge -->
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SecondaryRegionBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.PatternDefaultTooltip}}">
                                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.PatternDefault}}" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status / Enabled Toggle Column -->
                        <DataGridTemplateColumn Header="{extension:Lang Key={x:Static langs:LangKeys.Enabled}}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource ToggleButtonSwitch}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Live Tester Column -->
                        <DataGridTemplateColumn Header="{extension:Lang Key={x:Static langs:LangKeys.Test}}" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:TextBox x:Name="TestInput"
                                                Style="{StaticResource ValidatingTextBoxExtend}"
                                                hc:InfoElement.Placeholder="{extension:Lang Key={x:Static langs:LangKeys.TestSamplePlaceholder}}"
                                                hc:InfoElement.ShowClearButton="True"
                                                VerticalAlignment="Center"
                                                Margin="4,0"
                                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.TestSampleTooltip}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="{extension:Lang Key={x:Static langs:LangKeys.Action}}" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Built-in pattern: Subtle lock glyph (clean, no heavy box) -->
                                        <Path Data="{StaticResource LockOutlineGeometry}"
                                              Fill="{DynamicResource SecondaryTextBrush}"
                                              Opacity="0.35"
                                              Width="13" Height="13"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="{extension:Lang Key={x:Static langs:LangKeys.PatternDefaultCannotDelete}}"
                                              Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />

                                        <!-- Custom pattern: Refined rounded delete button -->
                                        <Button Style="{StaticResource DeleteIconButtonStyle}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{extension:Lang Key={x:Static langs:LangKeys.DeleteCustomPatternTooltip}}"
                                                Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 3. Bottom Footer Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{extension:Lang Key={x:Static langs:LangKeys.SubfolderSettingsFooter}}"
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding CloseCommand}"
                        Content="{extension:Lang Key={x:Static langs:LangKeys.Close}}"
                        Width="90" Height="32"
                        IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
