<UserControl x:Class="FoliCon.Views.ManualExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:viewModels="clr-namespace:FoliCon.ViewModels"
             xmlns:langs="clr-namespace:FoliCon.Properties.Langs"
             xmlns:extension="clr-namespace:FoliCon.Modules.Extension"
             xmlns:views="clr-namespace:FoliCon.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:ManualExplorerViewModel }"
             Background="{DynamicResource RegionBrush}"
             x:Name="Root">
    <UserControl.Resources>
        <hc:BindingProxy x:Key="Proxy" Value="{Binding}" />
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Height" Value="720" />
            <Setter Property="Width" Value="1060" />
            <Setter Property="MinHeight" Value="580" />
            <Setter Property="MinWidth" Value="860" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Gallery Content -->
            <RowDefinition Height="*" />
            <!-- Footer Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & File Count Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="8"
                            Width="38" Height="38"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource CleanFolderGeometry}"
                              Fill="White"
                              Width="20" Height="20"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                            <!-- High-contrast count badge -->
                            <Border Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="10"
                                    Padding="10,2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Directory.Count, StringFormat='{}{0} Extracted Icons'}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>

                            <TextBlock Text="Click to select • Double-click to choose"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Cancel Button -->
                <Button Grid.Column="1"
                        Content="{extension:Lang Key={x:Static langs:LangKeys.Cancel}}"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Padding="14,6"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Middle: Gallery Content with Busy Template -->
        <views:ImageGalleryControl Grid.Row="1"
                                   ItemsSource="{Binding Directory}"
                                   SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                   BindingPath="."
                                   UseCacheConverter="True"
                                   ItemWidth="140"
                                   ItemHeight="140"
                                   ImageStretch="Uniform"
                                   PreviewCommand="{Binding OpenImageCommand}"
                                   DoubleClickCommand="{Binding PickCommand}">
            <views:ImageGalleryControl.CustomBusyContentTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" MinWidth="280">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Path Data="{StaticResource AutoSparklesGeometry}"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Value.ProgressInfo.Text, Source={StaticResource Proxy}, FallbackValue='Downloading...'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Value.ProgressStatusText, Source={StaticResource Proxy}}"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,12"/>
                        
                        <ProgressBar Style="{DynamicResource ProgressBarFlat}"
                                     IsIndeterminate="{Binding Value.IsIndeterminate, Source={StaticResource Proxy}}"
                                     Value="{Binding Value.ProgressInfo.Value, Source={StaticResource Proxy}}" 
                                     Maximum="{Binding Value.ProgressInfo.Max, Source={StaticResource Proxy}}"
                                     Height="6"
                                     Margin="0,0,0,16"/>

                        <Button Content="{extension:Lang Key={x:Static langs:LangKeys.Cancel}}"
                                Style="{StaticResource ButtonDefault}"
                                HorizontalAlignment="Center"
                                Command="{Binding Value.CancelCommand, Source={StaticResource Proxy}}"
                                Padding="16,6"/>
                    </StackPanel>
                </DataTemplate>
            </views:ImageGalleryControl.CustomBusyContentTemplate>
        </views:ImageGalleryControl>

        <!-- Bottom Footer Bar: Actions & Hints -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Usage Tips -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource AutoSparklesGeometry}"
                          Fill="{DynamicResource PrimaryBrush}"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Select an icon above, or double-click to apply instantly"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Action Buttons (Preview Full Size, Pick Poster, Cancel) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonDefault}"
                            Command="{Binding PreviewSelectedCommand}"
                            Margin="0,0,10,0"
                            Padding="14,7"
                            VerticalAlignment="Center"
                            ToolTip="Preview selected icon in lightbox">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource EyeGeometry}"
                                  Fill="{DynamicResource PrimaryTextBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Preview Full Size"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ButtonPrimary}"
                            Command="{Binding PickSelectedCommand}"
                            Margin="0,0,10,0"
                            Padding="16,7"
                            VerticalAlignment="Center"
                            ToolTip="Apply the selected icon to folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CheckCircleGeometry}"
                                  Fill="White"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.PickSelected}}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Content="{extension:Lang Key={x:Static langs:LangKeys.Cancel}}"
                            Style="{StaticResource ButtonDefault}"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            Padding="14,7"
                            MinWidth="80"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>