<UserControl x:Class="FoliCon.Views.HtmlBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Integrated Blended Video Header Bar with matched top corner radius -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="5,5,0,0"
                Padding="10,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Video Badge Icon -->
                <Path Grid.Column="0" Data="{StaticResource TvGeometry}" Width="14" Height="14" Stretch="Uniform"
                      Fill="{DynamicResource PrimaryBrush}" Margin="4,0,8,0" VerticalAlignment="Center" />

                <!-- Full-Width Seamless Dropdown Selector -->
                <hc:ComboBox Grid.Column="1" x:Name="VideoSelector"
                             SelectionChanged="VideoSelector_OnSelectionChanged"
                             SelectedIndex="0"
                             Height="28"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4,2" FontSize="11.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Cursor="Hand" />
            </Grid>
        </Border>

        <!-- Video Player: Flush Cinema Display (No awkward gaps or double frames) -->
        <wv2:WebView2 Grid.Row="1" x:Name="Browser" Margin="0" />
    </Grid>
</UserControl>
