<UserControl x:Class="FoliCon.Views.AboutBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FoliCon.ViewModels"
             xmlns:langs="clr-namespace:FoliCon.Properties.Langs"
             xmlns:extension="clr-namespace:FoliCon.Modules.Extension"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:AboutBoxViewModel}"
             Background="{DynamicResource RegionBrush}"
             Width="540">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="hc:WindowAttach.IsDragElement" Value="True" />
            <Setter Property="Title" Value="{Binding Title}" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Hero Header Card -->
                <RowDefinition Height="Auto" />
                <!-- Description & Info Card -->
                <RowDefinition Height="Auto" />
                <!-- External Links Action Grid -->
                <RowDefinition Height="Auto" />
                <!-- Footer (Copyright & Close) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Hero Header Card -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- App Logo Card -->
                    <Border Grid.Column="0"
                            Width="64" Height="64"
                            CornerRadius="12"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <Image Source="{Binding Logo}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Width="48" Height="48"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- App Title, Version & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- App Name & Version Badge & Copy Button -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FoliCon"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Version Badge -->
                            <Border Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="10,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Static viewModels:AboutBoxViewModel.VersionTag}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>

                            <!-- Copy Full Version Button -->
                            <Button Style="{StaticResource ButtonIcon}"
                                    Command="{Binding CopyVersionCommand}"
                                    hc:IconElement.Geometry="{StaticResource CopyGeometry}"
                                    hc:IconElement.Width="12"
                                    hc:IconElement.Height="12"
                                    Width="26" Height="26"
                                    Padding="0"
                                    VerticalAlignment="Center">
                                <Button.ToolTip>
                                    <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                        <Binding Source="{StaticResource FoliConLangs}" Path="AboutVersionTooltip" />
                                        <Binding Path="Version" />
                                    </MultiBinding>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>

                        <!-- Subtitle / Tagline -->
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.AboutTagline}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Description & Details Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,12,0,0">
                <StackPanel>
                    <!-- Description Body -->
                    <TextBlock Text="{Binding Description}"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               FontSize="12.5"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <!-- Divider -->
                    <Rectangle Height="1"
                               Fill="{DynamicResource BorderBrush}"
                               Margin="0,12" />

                    <!-- Meta Information Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Developer Info -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource HeartGeometry}"
                                  Fill="{DynamicResource DangerBrush}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="{Binding AdditionalNotes}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- License Info -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Path Data="{StaticResource ShieldCheckGeometry}"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="{Binding License}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. External Resource Links -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- GitHub Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding OpenGithubCommand}"
                        Height="36"
                        ToolTip="{extension:Lang Key={x:Static langs:LangKeys.AboutGithubTooltip}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GithubGeometry}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.AboutGithub}}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Overlay Store Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding OpenOverlayStoreCommand}"
                        Height="36"
                        ToolTip="{extension:Lang Key={x:Static langs:LangKeys.AboutOverlaysTooltip}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource StoreGeometry}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.AboutOverlays}}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Website Button -->
                <Button Grid.Column="4"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding OpenWebsiteCommand}"
                        Height="36"
                        ToolTip="{extension:Lang Key={x:Static langs:LangKeys.AboutWebsiteTooltip}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ExternalLinkGeometry}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Margin="0,0,8,0" />
                        <TextBlock Text="{extension:Lang Key={x:Static langs:LangKeys.AboutWebsite}}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 4. Footer Bar -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Tag / Info note -->
                <TextBlock Grid.Column="0"
                           Text="{extension:Lang Key={x:Static langs:LangKeys.AboutLicenseFooter}}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />

                <!-- Close Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding CloseCommand}"
                        Content="{extension:Lang Key={x:Static langs:LangKeys.Close}}"
                        Width="90" Height="32"
                        IsDefault="True"
                        IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
