<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- FOLICON "MICA DARK OBSIDIAN" THEME (Cinephile Home Theater Palette)        -->
    <!-- Palette:                                                                  -->
    <!--   - Base Surfaces:     #090D16 / #0F172A (Deep midnight slate + Mica blur) -->
    <!--   - Containers:        #121826 / #162036 (Glassy cards & elevated panels) -->
    <!--   - Primary Accent:    #8B5CF6 / #7C3AED (Vibrant Electric Violet/Lavender)-->
    <!--   - Secondary / Status:#38BDF8 (Cyan edge & info) & #10B981 (Emerald Write)-->
    <!--   - Primary Text:      #F8FAFC (Crisp pale white)                         -->
    <!--   - Secondary Text:    #A78BFA (Warm lavender metadata)                   -->
    <!-- ========================================================================= -->

    <!-- Base Palette Colors -->
    <Color x:Key="BackgroundColor">#090D16</Color>
    <Color x:Key="PrimaryVioletColor">#8B5CF6</Color>
    <Color x:Key="DeepVioletColor">#7C3AED</Color>
    <Color x:Key="LavenderColor">#A78BFA</Color>
    <Color x:Key="LightTextColor">#F8FAFC</Color>

    <!-- Derived Surface, Border & State Colors -->
    <Color x:Key="DarkPrimaryColor">#6D28D9</Color>
    <Color x:Key="LightPrimaryColor">#C4B5FD</Color>
    <Color x:Key="CardSurfaceColor">#121826</Color>
    <Color x:Key="ElevatedSurfaceColor">#182236</Color>
    <Color x:Key="BorderLineColor">#243048</Color>
    <Color x:Key="SecondaryTextColor">#A78BFA</Color>
    <Color x:Key="TertiaryTextColor">#94A3B8</Color>

    <!-- HandyControl Standard Colors -->
    <Color x:Key="PrimaryColor">#8B5CF6</Color>
    <Color x:Key="RegionColor">#090D16</Color>
    <Color x:Key="SecondaryRegionColor">#121826</Color>
    <Color x:Key="ThirdRegionColor">#182236</Color>
    <Color x:Key="BorderColor">#243048</Color>
    <Color x:Key="PrimaryTextColor">#F8FAFC</Color>
    <Color x:Key="ThirdTextColor">#94A3B8</Color>

    <!-- HandyControl & FoliCon Theme Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource LavenderColor}" />

    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdRegionColor}" />
    <SolidColorBrush x:Key="ThirdRegionBrush" Color="{StaticResource ThirdRegionColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ThirdTextBrush" Color="{StaticResource ThirdTextColor}" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdTextColor}" />

    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="{StaticResource BackgroundColor}" />

    <!-- ========================================================================= -->
    <!-- MICA DARK OBSIDIAN GRADIENT & MATERIAL EFFECTS                            -->
    <!-- ========================================================================= -->
    <!-- Translucent Backdrop for Windows 11 Mica wallpaper blur -->
    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#D9090D16" />

    <!-- Glassy Obsidian-to-Midnight Hero Card Gradient -->
    <LinearGradientBrush x:Key="HeroCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#162036" Offset="0.0" />
        <GradientStop Color="#101726" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Top-Down Light-Incidence Border for Hero -->
    <LinearGradientBrush x:Key="HeroCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3E5279" Offset="0.0" />
        <GradientStop Color="#1C273C" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glowing Electric Violet-to-Fuchsia CTA Action Gradient -->
    <LinearGradientBrush x:Key="PrimaryActionGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0.0" />
        <GradientStop Color="#7C3AED" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Atmospheric Sheen Header Bar -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141C2E" Offset="0.0" />
        <GradientStop Color="#0D1320" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Fluid Bevel Card Borders -->
    <LinearGradientBrush x:Key="CardBorderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#334466" Offset="0.0" />
        <GradientStop Color="#1B2538" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Luminous Folder Badge Gradient -->
    <LinearGradientBrush x:Key="FolderBadgeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0.0" />
        <GradientStop Color="#6D28D9" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
