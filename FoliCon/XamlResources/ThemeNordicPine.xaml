<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- FOLICON "NORDIC PINE (EMERALD ABYSSAL)" THEME                             -->
    <!-- Palette:                                                                  -->
    <!--   - Base Surfaces:     #0C1613 / #13221E (Deep abyssal spruce & dark moss)-->
    <!--   - Elevated Surfaces: #1C322C (Pine elevated cards & panels)             -->
    <!--   - Primary Accent:    #10B981 / #059669 (Vibrant Mint Emerald)           -->
    <!--   - Secondary / Sage:  #6EE7B7 / #34D399 (Frosted sage & mint highlights) -->
    <!--   - Primary Text:      #ECFDF5 (Pale glacial frost white)                 -->
    <!--   - Secondary Text:    #6EE7B7 (Sage secondary labels & metadata)         -->
    <!-- ========================================================================= -->

    <!-- Base Palette Colors -->
    <Color x:Key="BackgroundColor">#0C1613</Color>
    <Color x:Key="PrimaryEmeraldColor">#10B981</Color>
    <Color x:Key="DeepEmeraldColor">#059669</Color>
    <Color x:Key="FrostedSageColor">#6EE7B7</Color>
    <Color x:Key="LightTextColor">#ECFDF5</Color>

    <!-- Derived Surface, Border & State Colors -->
    <Color x:Key="DarkPrimaryColor">#059669</Color>
    <Color x:Key="LightPrimaryColor">#6EE7B7</Color>
    <Color x:Key="CardSurfaceColor">#13221E</Color>
    <Color x:Key="ElevatedSurfaceColor">#1C322C</Color>
    <Color x:Key="BorderLineColor">#26463D</Color>
    <Color x:Key="SecondaryTextColor">#6EE7B7</Color>
    <Color x:Key="TertiaryTextColor">#7F9C93</Color>

    <!-- HandyControl Standard Colors -->
    <Color x:Key="PrimaryColor">#10B981</Color>
    <Color x:Key="RegionColor">#0C1613</Color>
    <Color x:Key="SecondaryRegionColor">#13221E</Color>
    <Color x:Key="ThirdRegionColor">#1C322C</Color>
    <Color x:Key="BorderColor">#26463D</Color>
    <Color x:Key="PrimaryTextColor">#ECFDF5</Color>
    <Color x:Key="ThirdTextColor">#7F9C93</Color>

    <!-- HandyControl & FoliCon Theme Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource FrostedSageColor}" />

    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdRegionColor}" />
    <SolidColorBrush x:Key="ThirdRegionBrush" Color="{StaticResource ThirdRegionColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ThirdTextBrush" Color="{StaticResource ThirdTextColor}" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdTextColor}" />

    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="{StaticResource BackgroundColor}" />

    <!-- ========================================================================= -->
    <!-- NORDIC PINE GRADIENT & MATERIAL EFFECTS                                   -->
    <!-- ========================================================================= -->
    <!-- Translucent Backdrop for Windows 11 Mica wallpaper blur -->
    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#D90C1613" />

    <!-- Glassy Abyssal-Spruce-to-Deep-Moss Hero Card Gradient -->
    <LinearGradientBrush x:Key="HeroCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#182A25" Offset="0.0" />
        <GradientStop Color="#11201C" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Top-Down Lichen-Edge Border for Hero -->
    <LinearGradientBrush x:Key="HeroCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3E6B5D" Offset="0.0" />
        <GradientStop Color="#223E35" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glowing Emerald-to-Pine CTA Action Gradient -->
    <LinearGradientBrush x:Key="PrimaryActionGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0.0" />
        <GradientStop Color="#059669" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Atmospheric Sheen Header Bar -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#162723" Offset="0.0" />
        <GradientStop Color="#0E1B17" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Fluid Bevel Card Borders -->
    <LinearGradientBrush x:Key="CardBorderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#355C50" Offset="0.0" />
        <GradientStop Color="#1D362E" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Luminous Emerald Folder Badge Gradient -->
    <LinearGradientBrush x:Key="FolderBadgeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0.0" />
        <GradientStop Color="#047857" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
