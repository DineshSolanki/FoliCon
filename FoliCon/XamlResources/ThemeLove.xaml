<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- FOLICON "LOVE" LIVING THEME                                               -->
    <!-- Palette (Calibrated from love_theme_palette.json):                        -->
    <!--   - Window Background:  #080610 (Deep velvet night obsidian)               -->
    <!--   - Surface Background: #171018 (Smoked dark plum surface)                -->
    <!--   - Panel Background:   #22151E (Frosted twilight wine panel)             -->
    <!--   - Primary Accent:     #FF4D7D (Vibrant electric heart rose)             -->
    <!--   - Secondary Accent:   #FF8CB3 (Cherry blossom pink highlight)           -->
    <!--   - Text Primary:       #F8E9EF (Crisp snow parchment)                    -->
    <!--   - Text Secondary:     #C6A7B3 (Muted lilac lavender)                    -->
    <!--   - Border:             #6A3264 (Delicate wine boundary)                  -->
    <!--   - Success:            #00D6A0 (Vibrant emerald glow)                    -->
    <!--   - Error:              #E83E5B (Radiant crimson alert)                   -->
    <!-- ========================================================================= -->

    <!-- Base Palette Colors -->
    <Color x:Key="BackgroundColor">#080610</Color>
    <Color x:Key="PrimaryAccentColor">#FF4D7D</Color>
    <Color x:Key="SecondaryAccentColor">#FF8CB3</Color>
    <Color x:Key="LightTextColor">#F8E9EF</Color>

    <!-- Derived Surface, Border & State Colors -->
    <Color x:Key="DarkPrimaryColor">#D6285A</Color>
    <Color x:Key="LightPrimaryColor">#FF8CB3</Color>
    <Color x:Key="CardSurfaceColor">#171018</Color>
    <Color x:Key="ElevatedSurfaceColor">#22151E</Color>
    <Color x:Key="BorderLineColor">#6A3264</Color>
    <Color x:Key="SecondaryTextColor">#C6A7B3</Color>
    <Color x:Key="TertiaryTextColor">#8F6580</Color>

    <!-- HandyControl Standard Colors -->
    <Color x:Key="PrimaryColor">#FF4D7D</Color>
    <Color x:Key="RegionColor">#080610</Color>
    <Color x:Key="SecondaryRegionColor">#171018</Color>
    <Color x:Key="ThirdRegionColor">#22151E</Color>
    <Color x:Key="BorderColor">#6A3264</Color>
    <Color x:Key="PrimaryTextColor">#F8E9EF</Color>
    <Color x:Key="ThirdTextColor">#8F6580</Color>
    <Color x:Key="SuccessColor">#00D6A0</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#E83E5B</Color>

    <!-- HandyControl & FoliCon Theme Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource SecondaryAccentColor}" />

    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdRegionColor}" />
    <SolidColorBrush x:Key="ThirdRegionBrush" Color="{StaticResource ThirdRegionColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ThirdTextBrush" Color="{StaticResource ThirdTextColor}" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdTextColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="{StaticResource BackgroundColor}" />

    <!-- ========================================================================= -->
    <!-- MATERIAL & LIVING THEME BRUSHES                                           -->
    <!-- ========================================================================= -->
    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#D0080610" />

    <!-- Frosted Twilight Acrylic Hero Card Gradient (Allows sunset skyline to shine through) -->
    <LinearGradientBrush x:Key="HeroCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B822151E" Offset="0.0" />
        <GradientStop Color="#70171018" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Radiant Rose-Plum Border for Hero -->
    <LinearGradientBrush x:Key="HeroCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#90FF4D7D" Offset="0.0" />
        <GradientStop Color="#306A3264" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glowing Rose-to-Crimson CTA Action Gradient -->
    <LinearGradientBrush x:Key="PrimaryActionGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8CB3" Offset="0.0" />
        <GradientStop Color="#FF4D7D" Offset="0.5" />
        <GradientStop Color="#D6285A" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Atmospheric Sheen Header Bar -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D022151E" Offset="0.0" />
        <GradientStop Color="#A0171018" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Fluid Bevel Card Borders -->
    <LinearGradientBrush x:Key="CardBorderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80FF8CB3" Offset="0.0" />
        <GradientStop Color="#306A3264" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Luminous Folder Badge Gradient -->
    <LinearGradientBrush x:Key="FolderBadgeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8CB3" Offset="0.0" />
        <GradientStop Color="#FF4D7D" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Living Theme Wallpapers & Assets -->
    <ImageBrush x:Key="ThemeWallpaperBrush"
                ImageSource="pack://application:,,,/FoliCon;component/Resources/Themes/love_backdrop.jpg"
                Stretch="UniformToFill" Opacity="0.90" />

    <ImageBrush x:Key="ThemeActionBannerBrush"
                ImageSource="pack://application:,,,/FoliCon;component/Resources/Themes/love_banner.jpg"
                Stretch="UniformToFill" />

    <LinearGradientBrush x:Key="ThemeActionBannerOverlayBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#60000000" Offset="0.0" />
        <GradientStop Color="#20FF4D7D" Offset="0.5" />
        <GradientStop Color="#60000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Individual Card Background Visual Brushes -->
    <ImageBrush x:Key="ThemeCardMovieBrush"
                ImageSource="pack://application:,,,/FoliCon;component/Resources/Themes/love_card_movie.jpg"
                Stretch="UniformToFill" Opacity="0.45" />

    <ImageBrush x:Key="ThemeCardTvBrush"
                ImageSource="pack://application:,,,/FoliCon;component/Resources/Themes/love_card_tv.jpg"
                Stretch="UniformToFill" Opacity="0.35" />

    <ImageBrush x:Key="ThemeCardGameBrush"
                ImageSource="pack://application:,,,/FoliCon;component/Resources/Themes/love_card_game.jpg"
                Stretch="UniformToFill" Opacity="0.35" />

    <ImageBrush x:Key="ThemeCardAutoBrush"
                ImageSource="pack://application:,,,/FoliCon;component/Resources/Themes/love_card_auto.jpg"
                Stretch="UniformToFill" Opacity="0.35" />

    <RadialGradientBrush x:Key="ThemeVignetteBrush" Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#00080610" Offset="0.0" />
        <GradientStop Color="#20080610" Offset="0.55" />
        <GradientStop Color="#80080610" Offset="1.0" />
    </RadialGradientBrush>

    <!-- Glow & Halos -->
    <DropShadowEffect x:Key="ThemeGlowEffect" BlurRadius="18" ShadowDepth="0" Opacity="0.75" Color="#FF4D7D" />
    <DropShadowEffect x:Key="ThemeCtaGlowEffect" BlurRadius="26" ShadowDepth="0" Opacity="0.85" Color="#FF4D7D" />
    <DropShadowEffect x:Key="ActiveCardGlowEffect" BlurRadius="18" ShadowDepth="0" Opacity="0.80" Color="#FF4D7D" />

    <!-- Theme Branding Glyph: Radiant Heart -->
    <Geometry x:Key="ThemeBrandingGeometry">M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z</Geometry>
</ResourceDictionary>
