<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- FOLICON "THE BUTTERFLY" THEME (Midnight Violet Palette)                   -->
    <!-- Palette:                                                                  -->
    <!--   - Background:      #17152B                                              -->
    <!--   - Primary violet:  #7651E8                                              -->
    <!--   - Accent lavender: #B69AFF                                              -->
    <!--   - Light text:      #F5F3FF                                              -->
    <!-- ========================================================================= -->

    <!-- Base Palette Colors -->
    <Color x:Key="BackgroundColor">#17152B</Color>
    <Color x:Key="PrimaryVioletColor">#7651E8</Color>
    <Color x:Key="AccentLavenderColor">#B69AFF</Color>
    <Color x:Key="LightTextColor">#F5F3FF</Color>

    <!-- Derived Surface, Border & State Colors -->
    <Color x:Key="DarkPrimaryColor">#5C3DBE</Color>
    <Color x:Key="LightPrimaryColor">#B69AFF</Color>
    <Color x:Key="CardSurfaceColor">#201D38</Color>
    <Color x:Key="ElevatedSurfaceColor">#2A254B</Color>
    <Color x:Key="BorderLineColor">#383161</Color>
    <Color x:Key="SecondaryTextColor">#B69AFF</Color>
    <Color x:Key="TertiaryTextColor">#887DAE</Color>

    <!-- HandyControl Standard Colors -->
    <Color x:Key="PrimaryColor">#7651E8</Color>
    <Color x:Key="RegionColor">#17152B</Color>
    <Color x:Key="SecondaryRegionColor">#201D38</Color>
    <Color x:Key="ThirdRegionColor">#2A254B</Color>
    <Color x:Key="BorderColor">#383161</Color>
    <Color x:Key="PrimaryTextColor">#F5F3FF</Color>
    <Color x:Key="ThirdTextColor">#887DAE</Color>

    <!-- HandyControl & FoliCon Theme Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentLavenderColor}" />

    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdRegionColor}" />
    <SolidColorBrush x:Key="ThirdRegionBrush" Color="{StaticResource ThirdRegionColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ThirdTextBrush" Color="{StaticResource ThirdTextColor}" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdTextColor}" />

    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="{StaticResource BackgroundColor}" />

    <!-- ========================================================================= -->
    <!-- BUTTERFLY GRADIENT & MATERIAL EFFECTS                                     -->
    <!-- ========================================================================= -->
    <!-- Translucent Backdrop for Windows 11 Mica wallpaper blur -->
    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#D917152B" />

    <!-- Radiant Hero Card Gradient -->
    <LinearGradientBrush x:Key="HeroCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#28224E" Offset="0.0" />
        <GradientStop Color="#1C1835" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Top-Down Light-Incidence Border for Hero -->
    <LinearGradientBrush x:Key="HeroCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#635298" Offset="0.0" />
        <GradientStop Color="#312954" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glowing Electric Violet-to-Fuchsia CTA Action Gradient -->
    <LinearGradientBrush x:Key="PrimaryActionGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7651E8" Offset="0.0" />
        <GradientStop Color="#9333EA" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Atmospheric Sheen Header Bar -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#231C40" Offset="0.0" />
        <GradientStop Color="#1A1730" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Fluid Bevel Card Borders -->
    <LinearGradientBrush x:Key="CardBorderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4D3F75" Offset="0.0" />
        <GradientStop Color="#292344" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Luminous Folder Badge Gradient -->
    <LinearGradientBrush x:Key="FolderBadgeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0.0" />
        <GradientStop Color="#6D28D9" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
