<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- FOLICON "TOKYO NEON" THEME (Cyberpunk Synthwave Palette)                  -->
    <!-- Palette:                                                                  -->
    <!--   - Background:        #0B0E17 (Deep obsidian night)                      -->
    <!--   - Primary cyan:      #00F0FF (Electric neon cyan)                       -->
    <!--   - Accent magenta:    #FF2A85 (Cyberpunk pink/magenta)                   -->
    <!--   - Text primary:      #F0F6FC (Crisp white)                              -->
    <!-- ========================================================================= -->

    <!-- Base Palette Colors -->
    <Color x:Key="BackgroundColor">#0B0E17</Color>
    <Color x:Key="PrimaryCyanColor">#088395</Color>
    <Color x:Key="AccentMagentaColor">#FF2A85</Color>
    <Color x:Key="NeonCyanColor">#00F0FF</Color>
    <Color x:Key="LightTextColor">#F8FAFC</Color>

    <!-- Derived Surface, Border & State Colors -->
    <Color x:Key="DarkPrimaryColor">#066675</Color>
    <Color x:Key="LightPrimaryColor">#0EA5E9</Color>
    <Color x:Key="CardSurfaceColor">#111827</Color>
    <Color x:Key="ElevatedSurfaceColor">#1A2234</Color>
    <Color x:Key="BorderLineColor">#243048</Color>
    <Color x:Key="SecondaryTextColor">#94A3B8</Color>
    <Color x:Key="TertiaryTextColor">#64748B</Color>

    <!-- HandyControl Standard Colors -->
    <Color x:Key="PrimaryColor">#088395</Color>
    <Color x:Key="RegionColor">#0B0E17</Color>
    <Color x:Key="SecondaryRegionColor">#111827</Color>
    <Color x:Key="ThirdRegionColor">#1A2234</Color>
    <Color x:Key="BorderColor">#243048</Color>
    <Color x:Key="PrimaryTextColor">#F8FAFC</Color>
    <Color x:Key="ThirdTextColor">#64748B</Color>

    <!-- HandyControl & FoliCon Theme Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentMagentaColor}" />

    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdRegionColor}" />
    <SolidColorBrush x:Key="ThirdRegionBrush" Color="{StaticResource ThirdRegionColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ThirdTextBrush" Color="{StaticResource ThirdTextColor}" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdTextColor}" />

    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="{StaticResource BackgroundColor}" />

    <!-- ========================================================================= -->
    <!-- TOKYO NEON GRADIENT & MATERIAL EFFECTS                                    -->
    <!-- ========================================================================= -->
    <!-- Translucent Backdrop for Windows 11 Mica wallpaper blur -->
    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#D90B0E17" />

    <!-- Cyberpunk Obsidian-to-Navy Hero Card Gradient -->
    <LinearGradientBrush x:Key="HeroCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#141E33" Offset="0.0" />
        <GradientStop Color="#0D1524" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Electric Neon Cyan Top-Down Light-Incidence Border -->
    <LinearGradientBrush x:Key="HeroCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#088395" Offset="0.0" />
        <GradientStop Color="#1D2A40" Offset="1.0" />
    </LinearGradientBrush>

    <!-- High-Contrast Cyan-to-Teal CTA Action Gradient -->
    <LinearGradientBrush x:Key="PrimaryActionGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#088395" Offset="0.0" />
        <GradientStop Color="#045A67" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Atmospheric Sheen Header Bar -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141C2B" Offset="0.0" />
        <GradientStop Color="#0D131F" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Subtle Hairline Bevel Card Borders -->
    <LinearGradientBrush x:Key="CardBorderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#304364" Offset="0.0" />
        <GradientStop Color="#1A2436" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Electric Cyan Glowing Folder Badge Gradient -->
    <LinearGradientBrush x:Key="FolderBadgeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F0FF" Offset="0.0" />
        <GradientStop Color="#088395" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
