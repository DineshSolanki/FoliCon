<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- FOLICON "CINEMA 35MM (GOLDEN HOUR)" THEME                                 -->
    <!-- Palette:                                                                  -->
    <!--   - Base Surfaces:     #141210 / #1E1B17 (Smoked espresso & roasted walnut)-->
    <!--   - Elevated Surfaces: #2B2620 (Amber-tinted warm screening room panels)   -->
    <!--   - Primary Accent:    #F59E0B / #D97706 (Warm Projector Gold / Amber)    -->
    <!--   - Secondary / Honey: #FCD34D / #FBBF24 (Honey highlight & golden badges)-->
    <!--   - Primary Text:      #FFFBEB (Warm parchment cream white)               -->
    <!--   - Secondary Text:    #FCD34D (Warm honey amber secondary text)          -->
    <!-- ========================================================================= -->

    <!-- Base Palette Colors -->
    <Color x:Key="BackgroundColor">#141210</Color>
    <Color x:Key="PrimaryGoldColor">#F59E0B</Color>
    <Color x:Key="DeepAmberColor">#D97706</Color>
    <Color x:Key="HoneyColor">#FCD34D</Color>
    <Color x:Key="LightTextColor">#FFFBEB</Color>

    <!-- Derived Surface, Border & State Colors -->
    <Color x:Key="DarkPrimaryColor">#D97706</Color>
    <Color x:Key="LightPrimaryColor">#FCD34D</Color>
    <Color x:Key="CardSurfaceColor">#1E1B17</Color>
    <Color x:Key="ElevatedSurfaceColor">#2B2620</Color>
    <Color x:Key="BorderLineColor">#3D352B</Color>
    <Color x:Key="SecondaryTextColor">#FCD34D</Color>
    <Color x:Key="TertiaryTextColor">#A89F91</Color>

    <!-- HandyControl Standard Colors -->
    <Color x:Key="PrimaryColor">#F59E0B</Color>
    <Color x:Key="RegionColor">#141210</Color>
    <Color x:Key="SecondaryRegionColor">#1E1B17</Color>
    <Color x:Key="ThirdRegionColor">#2B2620</Color>
    <Color x:Key="BorderColor">#3D352B</Color>
    <Color x:Key="PrimaryTextColor">#FFFBEB</Color>
    <Color x:Key="ThirdTextColor">#A89F91</Color>

    <!-- HandyControl & FoliCon Theme Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource HoneyColor}" />

    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdRegionColor}" />
    <SolidColorBrush x:Key="ThirdRegionBrush" Color="{StaticResource ThirdRegionColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ThirdTextBrush" Color="{StaticResource ThirdTextColor}" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdTextColor}" />

    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="{StaticResource BackgroundColor}" />

    <!-- ========================================================================= -->
    <!-- CINEMA 35MM GRADIENT & MATERIAL EFFECTS                                   -->
    <!-- ========================================================================= -->
    <!-- Translucent Backdrop for Windows 11 Mica wallpaper blur -->
    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#D9141210" />

    <!-- Smoked Espresso-to-Walnut Hero Card Gradient -->
    <LinearGradientBrush x:Key="HeroCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C0221D17" Offset="0.0" />
        <GradientStop Color="#8C161310" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Top-Down Antique Bronze Border for Hero -->
    <LinearGradientBrush x:Key="HeroCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80F59E0B" Offset="0.0" />
        <GradientStop Color="#26F59E0B" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glowing Projector Gold-to-Amber CTA Action Gradient -->
    <LinearGradientBrush x:Key="PrimaryActionGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA300" Offset="0.0" />
        <GradientStop Color="#E67300" Offset="0.5" />
        <GradientStop Color="#C45500" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Atmospheric Sheen Header Bar -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#211D18" Offset="0.0" />
        <GradientStop Color="#161310" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Fluid Bevel Card Borders -->
    <LinearGradientBrush x:Key="CardBorderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4D4031" Offset="0.0" />
        <GradientStop Color="#2A231B" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Luminous Projector Gold Folder Badge Gradient -->
    <LinearGradientBrush x:Key="FolderBadgeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0.0" />
        <GradientStop Color="#B45309" Offset="1.0" />
    </LinearGradientBrush>


    <!-- ========================================================================= -->
    <!-- LIVING THEME TOKENS                                                       -->
    <!-- ========================================================================= -->
    <ImageBrush x:Key="ThemeWallpaperBrush"
                ImageSource="pack://application:,,,/FoliCon;component/Resources/Themes/cinema_35mm_backdrop.jpg"
                Stretch="UniformToFill" Opacity="0.88" />

    <RadialGradientBrush x:Key="ThemeVignetteBrush" Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#00141210" Offset="0.0" />
        <GradientStop Color="#26141210" Offset="0.55" />
        <GradientStop Color="#8C141210" Offset="1.0" />
    </RadialGradientBrush>

    <DropShadowEffect x:Key="ThemeGlowEffect" BlurRadius="18" ShadowDepth="0" Opacity="0.75" Color="#FF8C00" />
    <DropShadowEffect x:Key="ThemeCtaGlowEffect" BlurRadius="26" ShadowDepth="0" Opacity="0.85" Color="#FF7A00" />
    <DropShadowEffect x:Key="ActiveCardGlowEffect" BlurRadius="18" ShadowDepth="0" Opacity="0.80" Color="#FF8C00" />

    <!-- Theme Branding Glyph -->
